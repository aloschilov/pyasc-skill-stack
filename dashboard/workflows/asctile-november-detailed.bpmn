<?xml version='1.0' encoding='utf-8'?>
<b:definitions xmlns:b="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bd="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions" targetNamespace="urn:pyasc:asctile-november-detailed" exporter="Camunda Modeler" exporterVersion="5.47.0">
  <b:process id="Workflow" name="asctile-november-detailed" isExecutable="false">
    <b:documentation>Source: https://github.com/aloschilov/pyasc-skill-stack/blob/4f6dae49c7a16f8a55911d2276d2f02408fa16b4/skills/asctile-codegen-workflow/SKILL.md . Read phase reference documents alongside the main skill. Five responsibility lanes show handoffs within one coordinated process. Phase entry and outcome events mark the boundaries of each phase. This diagram describes the skill instructions.</b:documentation>
    <b:laneSet id="Responsibilities">
      <b:lane id="Lane_Tuner" name="Tuner">
        <b:flowNodeRef>N_p4_c</b:flowNodeRef>
        <b:flowNodeRef>N_p4_h</b:flowNodeRef>
        <b:flowNodeRef>N_p4_alt_endh</b:flowNodeRef>
      </b:lane>
      <b:lane id="Lane_Verifier" name="Verifier">
        <b:flowNodeRef>N_p0_alt_stop</b:flowNodeRef>
        <b:flowNodeRef>N_p0_alt_endstop</b:flowNodeRef>
        <b:flowNodeRef>N_p3</b:flowNodeRef>
        <b:flowNodeRef>N_p3_a</b:flowNodeRef>
        <b:flowNodeRef>N_p3_b</b:flowNodeRef>
        <b:flowNodeRef>N_p3_c_check</b:flowNodeRef>
        <b:flowNodeRef>N_p3_c</b:flowNodeRef>
        <b:flowNodeRef>N_p3_d</b:flowNodeRef>
        <b:flowNodeRef>N_p3_e</b:flowNodeRef>
        <b:flowNodeRef>N_p3_f</b:flowNodeRef>
        <b:flowNodeRef>N_p3_g_check</b:flowNodeRef>
        <b:flowNodeRef>N_p3_g</b:flowNodeRef>
        <b:flowNodeRef>N_p3_j</b:flowNodeRef>
        <b:flowNodeRef>N_p3_k_check</b:flowNodeRef>
        <b:flowNodeRef>N_p3_k</b:flowNodeRef>
        <b:flowNodeRef>N_p3_l</b:flowNodeRef>
        <b:flowNodeRef>N_p3_z</b:flowNodeRef>
        <b:flowNodeRef>N_p3_alt_fix</b:flowNodeRef>
        <b:flowNodeRef>N_p3_alt_endfix</b:flowNodeRef>
        <b:flowNodeRef>N_p3_alt_block</b:flowNodeRef>
        <b:flowNodeRef>N_p3_alt_endblock</b:flowNodeRef>
        <b:flowNodeRef>N_valid_check</b:flowNodeRef>
        <b:flowNodeRef>N_valid</b:flowNodeRef>
      </b:lane>
      <b:lane id="Lane_Reviewer" name="Reviewer">
        <b:flowNodeRef>N_p2_k</b:flowNodeRef>
        <b:flowNodeRef>N_p2_l</b:flowNodeRef>
        <b:flowNodeRef>N_p2_m</b:flowNodeRef>
        <b:flowNodeRef>N_p2_n</b:flowNodeRef>
        <b:flowNodeRef>N_p2_o</b:flowNodeRef>
        <b:flowNodeRef>N_p2_p</b:flowNodeRef>
        <b:flowNodeRef>N_p2_g_check</b:flowNodeRef>
        <b:flowNodeRef>N_p2_g</b:flowNodeRef>
        <b:flowNodeRef>N_p2_z</b:flowNodeRef>
      </b:lane>
      <b:lane id="Lane_Author" name="Author">
        <b:flowNodeRef>N_p0_d</b:flowNodeRef>
        <b:flowNodeRef>N_p0_e</b:flowNodeRef>
        <b:flowNodeRef>N_p0_j_check</b:flowNodeRef>
        <b:flowNodeRef>N_p0_j</b:flowNodeRef>
        <b:flowNodeRef>N_p0_f</b:flowNodeRef>
        <b:flowNodeRef>N_p0_k_check</b:flowNodeRef>
        <b:flowNodeRef>N_p0_k</b:flowNodeRef>
        <b:flowNodeRef>N_p0_m</b:flowNodeRef>
        <b:flowNodeRef>N_p0_z</b:flowNodeRef>
        <b:flowNodeRef>N_p1</b:flowNodeRef>
        <b:flowNodeRef>N_p1_a</b:flowNodeRef>
        <b:flowNodeRef>N_p1_b</b:flowNodeRef>
        <b:flowNodeRef>N_p1_c</b:flowNodeRef>
        <b:flowNodeRef>N_p1_d</b:flowNodeRef>
        <b:flowNodeRef>N_p1_e</b:flowNodeRef>
        <b:flowNodeRef>N_p1_f</b:flowNodeRef>
        <b:flowNodeRef>N_p1_h</b:flowNodeRef>
        <b:flowNodeRef>N_p1_i</b:flowNodeRef>
        <b:flowNodeRef>N_p1_g_check</b:flowNodeRef>
        <b:flowNodeRef>N_p1_g</b:flowNodeRef>
        <b:flowNodeRef>N_p1_z</b:flowNodeRef>
        <b:flowNodeRef>N_p2</b:flowNodeRef>
        <b:flowNodeRef>N_p2_a</b:flowNodeRef>
        <b:flowNodeRef>N_p2_b</b:flowNodeRef>
        <b:flowNodeRef>N_p2_c</b:flowNodeRef>
        <b:flowNodeRef>N_p2_d</b:flowNodeRef>
        <b:flowNodeRef>N_p2_e_check</b:flowNodeRef>
        <b:flowNodeRef>N_p2_e</b:flowNodeRef>
        <b:flowNodeRef>N_p2_f</b:flowNodeRef>
        <b:flowNodeRef>N_repair</b:flowNodeRef>
      </b:lane>
      <b:lane id="Lane_Caller" name="Caller">
        <b:flowNodeRef>N_s</b:flowNodeRef>
        <b:flowNodeRef>N_load</b:flowNodeRef>
        <b:flowNodeRef>N_p0</b:flowNodeRef>
        <b:flowNodeRef>N_p0_a</b:flowNodeRef>
        <b:flowNodeRef>N_p0_g_check</b:flowNodeRef>
        <b:flowNodeRef>N_p0_g</b:flowNodeRef>
        <b:flowNodeRef>N_p0_alt_ask</b:flowNodeRef>
        <b:flowNodeRef>N_p0_b</b:flowNodeRef>
        <b:flowNodeRef>N_p0_h_check</b:flowNodeRef>
        <b:flowNodeRef>N_p0_h</b:flowNodeRef>
        <b:flowNodeRef>N_p0_c</b:flowNodeRef>
        <b:flowNodeRef>N_env_check</b:flowNodeRef>
        <b:flowNodeRef>N_env</b:flowNodeRef>
        <b:flowNodeRef>N_p2_h</b:flowNodeRef>
        <b:flowNodeRef>N_p2_i_check</b:flowNodeRef>
        <b:flowNodeRef>N_p2_i</b:flowNodeRef>
        <b:flowNodeRef>N_p2_alt_lim</b:flowNodeRef>
        <b:flowNodeRef>N_p2_alt_endlim</b:flowNodeRef>
        <b:flowNodeRef>N_p2_j</b:flowNodeRef>
        <b:flowNodeRef>N_review_check</b:flowNodeRef>
        <b:flowNodeRef>N_review</b:flowNodeRef>
        <b:flowNodeRef>N_p3_h_check</b:flowNodeRef>
        <b:flowNodeRef>N_p3_h</b:flowNodeRef>
        <b:flowNodeRef>N_p3_i</b:flowNodeRef>
        <b:flowNodeRef>N_tune_check</b:flowNodeRef>
        <b:flowNodeRef>N_tune</b:flowNodeRef>
        <b:flowNodeRef>N_p4</b:flowNodeRef>
        <b:flowNodeRef>N_p4_a</b:flowNodeRef>
        <b:flowNodeRef>N_p4_b_check</b:flowNodeRef>
        <b:flowNodeRef>N_p4_b</b:flowNodeRef>
        <b:flowNodeRef>N_p4_d_check</b:flowNodeRef>
        <b:flowNodeRef>N_p4_d</b:flowNodeRef>
        <b:flowNodeRef>N_p4_e</b:flowNodeRef>
        <b:flowNodeRef>N_p4_alt_keep</b:flowNodeRef>
        <b:flowNodeRef>N_p4_f_check</b:flowNodeRef>
        <b:flowNodeRef>N_p4_f</b:flowNodeRef>
        <b:flowNodeRef>N_p4_z</b:flowNodeRef>
        <b:flowNodeRef>N_pick_check</b:flowNodeRef>
        <b:flowNodeRef>N_pick</b:flowNodeRef>
        <b:flowNodeRef>N_deliver</b:flowNodeRef>
        <b:flowNodeRef>N_z</b:flowNodeRef>
        <b:flowNodeRef>N_limited</b:flowNodeRef>
        <b:flowNodeRef>N_limitend</b:flowNodeRef>
      </b:lane>
    </b:laneSet>
    <b:startEvent id="N_s">
      <b:documentation>Example: A user opens a kernel request for row-wise sum.</b:documentation>
      <b:outgoing>N_flow0</b:outgoing>
    </b:startEvent>
    <b:task id="N_load" name="Load the kernel development workflow">
      <b:documentation>Example: In OpenCode the caller asks the active session to invoke the native skill tool with the installed name asctile-codegen-workflow. The returned SKILL.md supplies the phase instructions. Record the loaded skill directory and hash with the run.</b:documentation>
      <b:incoming>N_flow0</b:incoming>
      <b:outgoing>N_flow1</b:outgoing>
    </b:task>
    <b:intermediateThrowEvent id="N_p0" name="Phase 0  /  Request, contract and pinned environment">
      <b:documentation>Example: Agree on row-wise sum over the last axis and identify the image that will compile the kernel. Example: The request says “implement row-wise sum” and leaves output dtype unspecified.</b:documentation>
      <b:incoming>N_flow1</b:incoming>
      <b:outgoing>N_p0_flow0</b:outgoing>
    </b:intermediateThrowEvent>
    <b:task id="N_p0_a" name="Clarify operator, dtype, shapes, outputs and tolerance">
      <b:documentation>Example: The caller is the coordinating agent or harness for the run. It gathers user answers and arranges author, reviewer and verifier handoffs. Here it confirms whether FP16 input rows produce FP32 sums.</b:documentation>
      <b:incoming>N_p0_flow0</b:incoming>
      <b:incoming>N_p0_flow10</b:incoming>
      <b:outgoing>N_p0_flow1</b:outgoing>
    </b:task>
    <b:task id="N_p0_g_check" name="Essential fields supplied?">
      <b:documentation>Example: For row-wise sum, require FP16 input of shapes (2,64) and (2,65), FP32 output of shape (2,), last-axis reduction and user-agreed tolerances. If tolerance is missing, ask.</b:documentation>
      <b:incoming>N_p0_flow1</b:incoming>
      <b:outgoing>N_p0_flow18</b:outgoing>
    </b:task>
    <b:exclusiveGateway id="N_p0_g">
      <b:documentation>Example: Route the recorded decision. For row-wise sum, require FP16 input of shapes (2,64) and (2,65), FP32 output of shape (2,), last-axis reduction and user-agreed tolerances. If tolerance is missing, ask.</b:documentation>
      <b:incoming>N_p0_flow18</b:incoming>
      <b:outgoing>N_p0_flow8</b:outgoing>
      <b:outgoing>N_p0_flow9</b:outgoing>
    </b:exclusiveGateway>
    <b:task id="N_p0_alt_ask" name="Ask user for missing contract fields">
      <b:documentation>Example: Ask the user “For FP16 rows of widths 64 and 65, should each row produce one FP32 sum? What absolute and relative tolerances should we use?” Resume clarification when the user answers.</b:documentation>
      <b:incoming>N_p0_flow9</b:incoming>
      <b:outgoing>N_p0_flow10</b:outgoing>
    </b:task>
    <b:task id="N_p0_b" name="Determine requested scope and whether optimization is requested">
      <b:documentation>Example: Record whether the user wants correctness qualification alone or also an official latency comparison.</b:documentation>
      <b:incoming>N_p0_flow8</b:incoming>
      <b:outgoing>N_p0_flow2</b:outgoing>
    </b:task>
    <b:task id="N_p0_h_check" name="Include tuning in contract?">
      <b:documentation>Example: Identify whether performance is part of the requested deliverable. If yes, agree the baseline and budget now. Measurements and variant changes belong to Phase 4 after correctness qualification.</b:documentation>
      <b:incoming>N_p0_flow2</b:incoming>
      <b:outgoing>N_p0_flow19</b:outgoing>
    </b:task>
    <b:exclusiveGateway id="N_p0_h">
      <b:documentation>Example: Route the recorded decision. Identify whether performance is part of the requested deliverable. If yes, agree the baseline and budget now. Measurements and variant changes belong to Phase 4 after correctness qualification.</b:documentation>
      <b:incoming>N_p0_flow19</b:incoming>
      <b:outgoing>N_p0_flow11</b:outgoing>
      <b:outgoing>N_p0_flow12</b:outgoing>
    </b:exclusiveGateway>
    <b:task id="N_p0_c" name="Agree baseline and time or attempt budget">
      <b:documentation>Example: For a speed request, confirm the baseline job and a limit of three variant attempts with the user.</b:documentation>
      <b:incoming>N_p0_flow11</b:incoming>
      <b:outgoing>N_p0_flow3</b:outgoing>
    </b:task>
    <b:task id="N_p0_d" name="Read ENV.json and PIN.json or identify explicitly selected runtime">
      <b:documentation>Example: For the repository image, read reference/images/ENV.json and reference/asctile/PIN.json and record the digest and matching source revision.</b:documentation>
      <b:incoming>N_p0_flow3</b:incoming>
      <b:incoming>N_p0_flow12</b:incoming>
      <b:outgoing>N_p0_flow4</b:outgoing>
    </b:task>
    <b:task id="N_p0_e" name="Record backend, platform, image or wheel identity; preflight selected interpreter">
      <b:documentation>Example: In the selected interpreter, record Python, module path and distribution version. Check that the imported AscTile module exposes jit and global_tensor.</b:documentation>
      <b:incoming>N_p0_flow4</b:incoming>
      <b:outgoing>N_p0_flow5</b:outgoing>
    </b:task>
    <b:task id="N_p0_j_check" name="Required runtime available?">
      <b:documentation>Example: A successful import from the selected artifact with jit and global_tensor takes Available. A missing symbol or a supplied unavailable-runtime fact takes Unavailable.</b:documentation>
      <b:incoming>N_p0_flow5</b:incoming>
      <b:outgoing>N_p0_flow20</b:outgoing>
    </b:task>
    <b:exclusiveGateway id="N_p0_j">
      <b:documentation>Example: Route the recorded decision. A successful import from the selected artifact with jit and global_tensor takes Available. A missing symbol or a supplied unavailable-runtime fact takes Unavailable.</b:documentation>
      <b:incoming>N_p0_flow20</b:incoming>
      <b:outgoing>N_p0_flow13</b:outgoing>
      <b:outgoing>N_p0_flow14</b:outgoing>
    </b:exclusiveGateway>
    <b:task id="N_p0_alt_stop" name="Record blocked stage and runtime diagnostic">
      <b:documentation>Example: Record blocked, the selected interpreter and its missing global_tensor diagnostic.</b:documentation>
      <b:incoming>N_p0_flow14</b:incoming>
      <b:outgoing>N_p0_flow17</b:outgoing>
    </b:task>
    <b:intermediateThrowEvent id="N_p0_alt_endstop" name="Preflight blocked">
      <b:documentation>Example: The required import failed in the selected image. Return the blocked result to the parent workflow.</b:documentation>
      <b:incoming>N_p0_flow17</b:incoming>
      <b:outgoing>return_N_p0_alt_endstop</b:outgoing>
    </b:intermediateThrowEvent>
    <b:task id="N_p0_f" name="Read nearest target test and operator contract">
      <b:documentation>Example: Compare the requested last-axis sum and output dtype with the nearest shipped reduction test.</b:documentation>
      <b:incoming>N_p0_flow13</b:incoming>
      <b:outgoing>N_p0_flow6</b:outgoing>
    </b:task>
    <b:task id="N_p0_k_check" name="Shipped references sufficient?">
      <b:documentation>Example: If a shipped reduction test answers the API question, proceed. If the transfer rank remains unclear, inspect matching upstream source.</b:documentation>
      <b:incoming>N_p0_flow6</b:incoming>
      <b:outgoing>N_p0_flow21</b:outgoing>
    </b:task>
    <b:exclusiveGateway id="N_p0_k">
      <b:documentation>Example: Route the recorded decision. If a shipped reduction test answers the API question, proceed. If the transfer rank remains unclear, inspect matching upstream source.</b:documentation>
      <b:incoming>N_p0_flow21</b:incoming>
      <b:outgoing>N_p0_flow15</b:outgoing>
      <b:outgoing>N_p0_flow16</b:outgoing>
    </b:exclusiveGateway>
    <b:task id="N_p0_m" name="Consult matching upstream source">
      <b:documentation>Example: If the shipped test omits the required descriptor form, inspect its implementation at the pinned upstream revision. July: pyasc-codegen-workflow/SKILL.md, Phase 1 step 2, requires golden/kernels/abs_f16.py and, if available, the upstream asc2/test_vadd.py. November: start with reference/asctile/target/test_reduce_sum.py for row sums. Consult source matching reference/asctile/PIN.json only if the shipped tests leave a question open.</b:documentation>
      <b:incoming>N_p0_flow16</b:incoming>
      <b:outgoing>N_p0_flow7</b:outgoing>
    </b:task>
    <b:intermediateThrowEvent id="N_p0_z" name="Preflight ready">
      <b:documentation>Example: The contract, selected image and shipped reduction reference are identified. The runtime probe succeeded. Author hands Caller the agreed case matrix, tolerance, runtime identity and preflight result. Caller checks readiness and releases the same inputs to the design task. The skill specifies no separate Phase 0 handoff file.</b:documentation>
      <b:incoming>N_p0_flow7</b:incoming>
      <b:incoming>N_p0_flow15</b:incoming>
      <b:outgoing>return_N_p0_z</b:outgoing>
    </b:intermediateThrowEvent>
    <b:task id="N_env_check" name="Preflight outcome?">
      <b:documentation>Example: Read Phase 0's recorded result. Ready requires an agreed contract, the selected runtime identity and a successful import exposing jit and global_tensor there. If unavailable, route the recorded diagnostic to the limited report. This is the exit gate for starting design.</b:documentation>
      <b:incoming>return_N_p0_z</b:incoming>
      <b:incoming>return_N_p0_alt_endstop</b:incoming>
      <b:outgoing>N_flow21</b:outgoing>
    </b:task>
    <b:exclusiveGateway id="N_env">
      <b:documentation>Example: Route the recorded decision. Read Phase 0's recorded result. Ready requires an agreed contract, the selected runtime identity and a successful import exposing jit and global_tensor there. If unavailable, route the recorded diagnostic to the limited report. This is the exit gate for starting design.</b:documentation>
      <b:incoming>N_flow21</b:incoming>
      <b:outgoing>N_flow3</b:outgoing>
      <b:outgoing>N_flow4</b:outgoing>
    </b:exclusiveGateway>
    <b:intermediateThrowEvent id="N_p1" name="Phase 1  /  Design and API selection">
      <b:documentation>Example: Design FP32 accumulation and an explicit device route for the last partial tile. Example: Start from the agreed FP16 row-sum contract and pinned source.</b:documentation>
      <b:incoming>N_flow4</b:incoming>
      <b:outgoing>N_p1_flow0</b:outgoing>
    </b:intermediateThrowEvent>
    <b:task id="N_p1_a" name="Specify semantics and public signature">
      <b:documentation>Example: Specify sum_rows(x) returning one FP32 sum per input row over the last axis. Example: sum_rows(x) accepts a two-dimensional FP16 tensor and returns one FP32 sum per row. Select any flow node to read its worked example in the HTML viewer or its BPMN Documentation field.</b:documentation>
      <b:incoming>N_p1_flow0</b:incoming>
      <b:outgoing>N_p1_flow1</b:outgoing>
    </b:task>
    <b:task id="N_p1_b" name="Enumerate shapes, dtypes, attributes and special values">
      <b:documentation>Example: List (2,64) and (2,65), output (2,), cancellation inputs and the agreed NaN behavior.</b:documentation>
      <b:incoming>N_p1_flow1</b:incoming>
      <b:outgoing>N_p1_flow2</b:outgoing>
    </b:task>
    <b:task id="N_p1_c" name="Plan host dispatch and JIT specializations">
      <b:documentation>Example: Map width 64 to a full-tile path and width 65 to a device path handling a partial tile.</b:documentation>
      <b:incoming>N_p1_flow2</b:incoming>
      <b:incoming>N_p1_flow10</b:incoming>
      <b:outgoing>N_p1_flow3</b:outgoing>
    </b:task>
    <b:task id="N_p1_d" name="Select descriptors and match local, offset and transfer ranks">
      <b:documentation>Example: For a rank-two tile, check that its descriptor, offsets and copy operands use the ranks required by the pinned API.</b:documentation>
      <b:incoming>N_p1_flow3</b:incoming>
      <b:outgoing>N_p1_flow4</b:outgoing>
    </b:task>
    <b:task id="N_p1_e" name="Plan tiles, tails, neutral padding, cores and UB capacity">
      <b:documentation>Example: For width 65 with a 64-element tile, plan one full tile and one valid tail element. Zero-pad inactive sum lanes and account for temporary buffers. Design establishes feasible tile sizes, UB bounds, tail padding and dispatch rules. For width 65, try 64 columns plus a masked tail. Compile or dry-run specializations to check feasibility; the host can select a qualified route at runtime. Revise failed plans and measure tuning variants after correctness.</b:documentation>
      <b:incoming>N_p1_flow4</b:incoming>
      <b:outgoing>N_p1_flow5</b:outgoing>
    </b:task>
    <b:task id="N_p1_f" name="Choose precision, reduction and fallback device routes">
      <b:documentation>Example: Accumulate FP16 values in FP32. Keep the tail reduction on the device. Example: accumulate FP16 rows in FP32, using zero for padded sum lanes. Evaluate a single-tile reduction or combine per-tile partials on device for wider rows. Select using the contract, pinned API support and numerical checks.</b:documentation>
      <b:incoming>N_p1_flow5</b:incoming>
      <b:outgoing>N_p1_flow6</b:outgoing>
    </b:task>
    <b:task id="N_p1_h" name="Define static, compile, numerical and hardware validation scope">
      <b:documentation>Example: In design.md map contract cases to gates and pass criteria. For widths 64 and 65, check signature and syntax, compile both dispatch paths on the pin and compare seeded CaModel outputs to FP32 reference sums at the agreed tolerances. If NPU evidence is requested, require official per-case results there.</b:documentation>
      <b:incoming>N_p1_flow6</b:incoming>
      <b:outgoing>N_p1_flow7</b:outgoing>
    </b:task>
    <b:task id="N_p1_i" name="Write design.md">
      <b:documentation>Example: Save the dispatch table, tile and tail diagrams, buffer budget and validation matrix in design.md.</b:documentation>
      <b:incoming>N_p1_flow7</b:incoming>
      <b:outgoing>N_p1_flow8</b:outgoing>
    </b:task>
    <b:task id="N_p1_g_check" name="Complete contract, supported APIs and device numerical routes?">
      <b:documentation>Example: Reject a design that sends width 65 to a host sum. Accept once every case has a supported device route and validation plan.</b:documentation>
      <b:incoming>N_p1_flow8</b:incoming>
      <b:outgoing>N_p1_flow11</b:outgoing>
    </b:task>
    <b:exclusiveGateway id="N_p1_g">
      <b:documentation>Example: Route the recorded decision. Reject a design that sends width 65 to a host sum. Accept once every case has a supported device route and validation plan.</b:documentation>
      <b:incoming>N_p1_flow11</b:incoming>
      <b:outgoing>N_p1_flow9</b:outgoing>
      <b:outgoing>N_p1_flow10</b:outgoing>
    </b:exclusiveGateway>
    <b:intermediateThrowEvent id="N_p1_z" name="Design accepted">
      <b:documentation>Example: The design covers both widths and uses reduction and transfer APIs present at the pin.</b:documentation>
      <b:incoming>N_p1_flow9</b:incoming>
      <b:outgoing>return_N_p1_z</b:outgoing>
    </b:intermediateThrowEvent>
    <b:intermediateThrowEvent id="N_p2" name="Phase 2  /  Implementation, handoff and acceptance review">
      <b:documentation>Example: Implement the sum kernel, hash it, and hand those exact bytes to a fresh reviewer session. Example: The accepted design specifies both full-tile and tail cases.</b:documentation>
      <b:incoming>N_flow11</b:incoming>
      <b:incoming>N_flow17</b:incoming>
      <b:incoming>return_N_p1_z</b:incoming>
      <b:outgoing>N_p2_flow0</b:outgoing>
    </b:intermediateThrowEvent>
    <b:task id="N_p2_a" name="Load asctile-api-patterns and asctile-syntax-constraints">
      <b:documentation>Example: Load the pinned API and syntax skills before selecting the reduction implementation.</b:documentation>
      <b:incoming>N_p2_flow0</b:incoming>
      <b:outgoing>N_p2_flow1</b:outgoing>
    </b:task>
    <b:task id="N_p2_b" name="Select matching template or target test and runtime import">
      <b:documentation>Example: Start with the closest target reduction test and check its import against the chosen runtime. Start from skills/asctile-codegen-workflow/templates/kernel-template.py for the common skeleton, or reference/asctile/target/test_reduce_sum.py for a matching row-reduction pattern. Verify the import against the pinned runtime.</b:documentation>
      <b:incoming>N_p2_flow1</b:incoming>
      <b:outgoing>N_p2_flow2</b:outgoing>
    </b:task>
    <b:task id="N_p2_c" name="Implement global_tensor, copy_in, compute and copy_out">
      <b:documentation>Example: Create the input descriptor, copy the row tile in, reduce on device and copy the valid output back. Example: wrap a 2-D input with global_tensor, copy_in the row tile with zero padding, accumulate in the agreed precision, reduce along axis 1, then copy_out one sum per valid row.</b:documentation>
      <b:incoming>N_p2_flow2</b:incoming>
      <b:incoming>N_p2_flow15</b:incoming>
      <b:incoming>N_p2_flow19</b:incoming>
      <b:outgoing>N_p2_flow3</b:outgoing>
    </b:task>
    <b:task id="N_p2_d" name="Run py_compile and static contract checks">
      <b:documentation>Example: Run python3 -m py_compile kernel.py and check the public signature and device computation path.</b:documentation>
      <b:incoming>N_p2_flow3</b:incoming>
      <b:outgoing>N_p2_flow4</b:outgoing>
    </b:task>
    <b:task id="N_p2_e_check" name="Syntax and contract checks passed?">
      <b:documentation>Example: A malformed kernel.py returns to implementation. Successful syntax and contract checks continue to self-review.</b:documentation>
      <b:incoming>N_p2_flow4</b:incoming>
      <b:outgoing>N_p2_flow21</b:outgoing>
    </b:task>
    <b:exclusiveGateway id="N_p2_e">
      <b:documentation>Example: Route the recorded decision. A malformed kernel.py returns to implementation. Successful syntax and contract checks continue to self-review.</b:documentation>
      <b:incoming>N_p2_flow21</b:incoming>
      <b:outgoing>N_p2_flow14</b:outgoing>
      <b:outgoing>N_p2_flow15</b:outgoing>
    </b:exclusiveGateway>
    <b:task id="N_p2_f" name="Self-review routes, ranks, casts, tails and output shapes">
      <b:documentation>Example: Trace the final one-element tile for width 65 and check accumulator dtype and output index.</b:documentation>
      <b:incoming>N_p2_flow14</b:incoming>
      <b:outgoing>N_p2_flow5</b:outgoing>
    </b:task>
    <b:task id="N_p2_h" name="Bind task, design, source, skills and candidate hashes">
      <b:documentation>Example: Record SHA-256 values for the task, design, loaded skills and kernel together with the source commit.</b:documentation>
      <b:incoming>N_p2_flow5</b:incoming>
      <b:outgoing>N_p2_flow6</b:outgoing>
    </b:task>
    <b:task id="N_p2_i_check" name="Fresh reviewer session available?">
      <b:documentation>Example: Use a distinct reviewer session if available. Otherwise record that only self-review ran.</b:documentation>
      <b:incoming>N_p2_flow6</b:incoming>
      <b:outgoing>N_p2_flow22</b:outgoing>
    </b:task>
    <b:exclusiveGateway id="N_p2_i">
      <b:documentation>Example: Route the recorded decision. Use a distinct reviewer session if available. Otherwise record that only self-review ran.</b:documentation>
      <b:incoming>N_p2_flow22</b:incoming>
      <b:outgoing>N_p2_flow16</b:outgoing>
      <b:outgoing>N_p2_flow17</b:outgoing>
    </b:exclusiveGateway>
    <b:task id="N_p2_alt_lim" name="Record self-review only; separate acceptance unverified">
      <b:documentation>Example: Record the author's self-review and identify independent session review as unverified.</b:documentation>
      <b:incoming>N_p2_flow17</b:incoming>
      <b:outgoing>N_p2_flow20</b:outgoing>
    </b:task>
    <b:intermediateThrowEvent id="N_p2_alt_endlim" name="Self-review only">
      <b:documentation>Example: End this phase with a self-review-only result for the limited report.</b:documentation>
      <b:incoming>N_p2_flow20</b:incoming>
      <b:outgoing>return_N_p2_alt_endlim</b:outgoing>
    </b:intermediateThrowEvent>
    <b:task id="N_p2_j" name="Transfer candidate and design to a fresh session; record model and session IDs">
      <b:documentation>Example: Give the reviewer the kernel and design by hash in a new session and record the actual author and reviewer session and model IDs.</b:documentation>
      <b:incoming>N_p2_flow16</b:incoming>
      <b:outgoing>N_p2_flow7</b:outgoing>
    </b:task>
    <b:task id="N_p2_k" name="Load asctile-code-review; check public contract and every case">
      <b:documentation>Example: Verify the reviewed module accepts both promised shapes and returns two FP32 sums.</b:documentation>
      <b:incoming>N_p2_flow7</b:incoming>
      <b:outgoing>N_p2_flow8</b:outgoing>
    </b:task>
    <b:task id="N_p2_l" name="Check host/device boundary and exact-runtime API">
      <b:documentation>Example: Check that width selection runs on the host while arithmetic runs on device through APIs in the pinned source.</b:documentation>
      <b:incoming>N_p2_flow8</b:incoming>
      <b:outgoing>N_p2_flow9</b:outgoing>
    </b:task>
    <b:task id="N_p2_m" name="Check memory ranks, alignment, neutral padding and buffer capacity">
      <b:documentation>Example: Check the width-65 tail offset, valid transfer extent and space for the FP32 accumulator.</b:documentation>
      <b:incoming>N_p2_flow9</b:incoming>
      <b:outgoing>N_p2_flow10</b:outgoing>
    </b:task>
    <b:task id="N_p2_n" name="Check precision, special values and cross-core reductions">
      <b:documentation>Example: Check cancellation and NaN behavior against the contract and confirm that each row has a single final writer.</b:documentation>
      <b:incoming>N_p2_flow10</b:incoming>
      <b:outgoing>N_p2_flow11</b:outgoing>
    </b:task>
    <b:task id="N_p2_o" name="Inspect occupancy, DMA, tiling and evidence claims">
      <b:documentation>Example: Flag a timing claim supported only by simulator runs and inspect whether small row counts leave cores idle.</b:documentation>
      <b:incoming>N_p2_flow11</b:incoming>
      <b:outgoing>N_p2_flow12</b:outgoing>
    </b:task>
    <b:task id="N_p2_p" name="Return findings with location, affected cases, repair and residual risks">
      <b:documentation>Example: Report the copy_out location, width-65 reproducer and expected fix if the tail writes outside its output row.</b:documentation>
      <b:incoming>N_p2_flow12</b:incoming>
      <b:outgoing>N_p2_flow13</b:outgoing>
    </b:task>
    <b:task id="N_p2_g_check" name="Contract preserved and blocking findings resolved?">
      <b:documentation>Example: An open tail-store blocker returns to implementation. A fresh review accepting the current bytes releases them to qualification.</b:documentation>
      <b:incoming>N_p2_flow13</b:incoming>
      <b:outgoing>N_p2_flow23</b:outgoing>
    </b:task>
    <b:exclusiveGateway id="N_p2_g">
      <b:documentation>Example: Route the recorded decision. An open tail-store blocker returns to implementation. A fresh review accepting the current bytes releases them to qualification.</b:documentation>
      <b:incoming>N_p2_flow23</b:incoming>
      <b:outgoing>N_p2_flow18</b:outgoing>
      <b:outgoing>N_p2_flow19</b:outgoing>
    </b:exclusiveGateway>
    <b:intermediateThrowEvent id="N_p2_z" name="Review accepted">
      <b:documentation>Example: The reviewer accepts the SHA-256 of the candidate that now goes to qualification.</b:documentation>
      <b:incoming>N_p2_flow18</b:incoming>
      <b:outgoing>return_N_p2_z</b:outgoing>
    </b:intermediateThrowEvent>
    <b:task id="N_review_check" name="Review evidence?">
      <b:documentation>Example: A fresh review names the current SHA-256 and has no open blocker. A self-review alone takes the limited-report path.</b:documentation>
      <b:incoming>return_N_p2_z</b:incoming>
      <b:incoming>return_N_p2_alt_endlim</b:incoming>
      <b:outgoing>N_flow22</b:outgoing>
    </b:task>
    <b:exclusiveGateway id="N_review">
      <b:documentation>Example: Route the recorded decision. A fresh review names the current SHA-256 and has no open blocker. A self-review alone takes the limited-report path.</b:documentation>
      <b:incoming>N_flow22</b:incoming>
      <b:outgoing>N_flow7</b:outgoing>
      <b:outgoing>N_flow8</b:outgoing>
    </b:exclusiveGateway>
    <b:intermediateThrowEvent id="N_p3" name="Phase 3  /  Qualification of the reviewed bytes">
      <b:documentation>Example: Compile both widths, run seeded comparisons and report each requested gate against the reviewed hash. Example: Retrieve the accepted kernel and confirm its hash before testing.</b:documentation>
      <b:incoming>N_flow8</b:incoming>
      <b:outgoing>N_p3_flow0</b:outgoing>
    </b:intermediateThrowEvent>
    <b:task id="N_p3_a" name="Check syntax, static contract and anti-cheat rules">
      <b:documentation>Example: Check the signature and reject a kernel that computes row sums on the host.</b:documentation>
      <b:incoming>N_p3_flow0</b:incoming>
      <b:outgoing>N_p3_flow1</b:outgoing>
    </b:task>
    <b:task id="N_p3_b" name="Dispatch and compile every case and specialization on the exact runtime">
      <b:documentation>Example: Compile the full-tile and tail dispatch cases on the recorded runtime and retain both outcomes.</b:documentation>
      <b:incoming>N_p3_flow1</b:incoming>
      <b:outgoing>N_p3_flow2</b:outgoing>
    </b:task>
    <b:task id="N_p3_c_check" name="All required static and lowering checks pass?">
      <b:documentation>Example: A lowering error for width 65 is a candidate failure. An unavailable compiler blocks execution. Successful compilation of both paths permits smoke testing.</b:documentation>
      <b:incoming>N_p3_flow2</b:incoming>
      <b:outgoing>N_p3_flow22</b:outgoing>
    </b:task>
    <b:exclusiveGateway id="N_p3_c">
      <b:documentation>Example: Route the recorded decision. A lowering error for width 65 is a candidate failure. An unavailable compiler blocks execution. Successful compilation of both paths permits smoke testing.</b:documentation>
      <b:incoming>N_p3_flow22</b:incoming>
      <b:outgoing>N_p3_flow9</b:outgoing>
      <b:outgoing>N_p3_flow10</b:outgoing>
      <b:outgoing>N_p3_flow11</b:outgoing>
    </b:exclusiveGateway>
    <b:task id="N_p3_d" name="Execute ordinary and adversarial CaModel inputs">
      <b:documentation>Example: Run seeded ordinary rows and a cancellation-heavy width-65 row in CaModel.</b:documentation>
      <b:incoming>N_p3_flow9</b:incoming>
      <b:outgoing>N_p3_flow3</b:outgoing>
    </b:task>
    <b:task id="N_p3_e" name="Compare outputs, shapes, dtypes, NaN/Inf positions and tolerances">
      <b:documentation>Example: Compare FP32 values against a seeded reference at the agreed tolerances, checking output shape and special-value positions separately.</b:documentation>
      <b:incoming>N_p3_flow3</b:incoming>
      <b:outgoing>N_p3_flow4</b:outgoing>
    </b:task>
    <b:task id="N_p3_f" name="Run full feasible CaModel matrix and record scope">
      <b:documentation>Example: Record each feasible shape and seed, mismatches, and any case left unrun.</b:documentation>
      <b:incoming>N_p3_flow4</b:incoming>
      <b:outgoing>N_p3_flow5</b:outgoing>
    </b:task>
    <b:task id="N_p3_g_check" name="Required numerical comparisons pass?">
      <b:documentation>Example: Continue when all required comparisons meet tolerance. Route a mismatch to repair or a missing simulator to the blocked report.</b:documentation>
      <b:incoming>N_p3_flow5</b:incoming>
      <b:outgoing>N_p3_flow23</b:outgoing>
    </b:task>
    <b:exclusiveGateway id="N_p3_g">
      <b:documentation>Example: Route the recorded decision. Continue when all required comparisons meet tolerance. Route a mismatch to repair or a missing simulator to the blocked report.</b:documentation>
      <b:incoming>N_p3_flow23</b:incoming>
      <b:outgoing>N_p3_flow12</b:outgoing>
      <b:outgoing>N_p3_flow13</b:outgoing>
      <b:outgoing>N_p3_flow14</b:outgoing>
    </b:exclusiveGateway>
    <b:task id="N_p3_h_check" name="Hardware qualification in scope?">
      <b:documentation>Example: A request for NPU qualification enters the hardware path. Simulator-only scope goes directly to recording results.</b:documentation>
      <b:incoming>N_p3_flow12</b:incoming>
      <b:outgoing>N_p3_flow24</b:outgoing>
    </b:task>
    <b:exclusiveGateway id="N_p3_h">
      <b:documentation>Example: Route the recorded decision. A request for NPU qualification enters the hardware path. Simulator-only scope goes directly to recording results.</b:documentation>
      <b:incoming>N_p3_flow24</b:incoming>
      <b:outgoing>N_p3_flow15</b:outgoing>
      <b:outgoing>N_p3_flow16</b:outgoing>
    </b:exclusiveGateway>
    <b:task id="N_p3_i" name="Apply asctile-cannbench-kernel contract and submit privately">
      <b:documentation>Example: For a requested, authorized hardware run, package the reviewed kernel for its benchmark contract and record the private job identity.</b:documentation>
      <b:incoming>N_p3_flow15</b:incoming>
      <b:outgoing>N_p3_flow6</b:outgoing>
    </b:task>
    <b:task id="N_p3_j" name="Collect official case outcomes, device timings and job identity">
      <b:documentation>Example: Attach the official job result with per-case correctness and device latency for the reviewed artifact.</b:documentation>
      <b:incoming>N_p3_flow6</b:incoming>
      <b:outgoing>N_p3_flow7</b:outgoing>
    </b:task>
    <b:task id="N_p3_k_check" name="Official hardware checks pass?">
      <b:documentation>Example: An official job passing all required cases goes to reporting. A wrong answer needs repair. An unavailable result is recorded as blocked.</b:documentation>
      <b:incoming>N_p3_flow7</b:incoming>
      <b:outgoing>N_p3_flow25</b:outgoing>
    </b:task>
    <b:exclusiveGateway id="N_p3_k">
      <b:documentation>Example: Route the recorded decision. An official job passing all required cases goes to reporting. A wrong answer needs repair. An unavailable result is recorded as blocked.</b:documentation>
      <b:incoming>N_p3_flow25</b:incoming>
      <b:outgoing>N_p3_flow17</b:outgoing>
      <b:outgoing>N_p3_flow18</b:outgoing>
      <b:outgoing>N_p3_flow19</b:outgoing>
    </b:exclusiveGateway>
    <b:task id="N_p3_l" name="Record passed gates, provenance and evidence scope">
      <b:documentation>Example: Report which cases compiled and passed in CaModel, then attach NPU outcomes if hardware was in scope.</b:documentation>
      <b:incoming>N_p3_flow16</b:incoming>
      <b:incoming>N_p3_flow17</b:incoming>
      <b:outgoing>N_p3_flow8</b:outgoing>
    </b:task>
    <b:intermediateThrowEvent id="N_p3_z" name="Requested gates passed">
      <b:documentation>Example: All requested cases have evidence at the agreed qualification scope.</b:documentation>
      <b:incoming>N_p3_flow8</b:incoming>
      <b:outgoing>return_N_p3_z</b:outgoing>
    </b:intermediateThrowEvent>
    <b:task id="N_p3_alt_fix" name="Record candidate failure, affected cases and reproduction">
      <b:documentation>Example: Record the failing width, seed, expected and observed value, runtime identity and candidate hash.</b:documentation>
      <b:incoming>N_p3_flow10</b:incoming>
      <b:incoming>N_p3_flow13</b:incoming>
      <b:incoming>N_p3_flow18</b:incoming>
      <b:outgoing>N_p3_flow20</b:outgoing>
    </b:task>
    <b:intermediateThrowEvent id="N_p3_alt_endfix" name="Repair required">
      <b:documentation>Example: Return the width-65 mismatch and reproducer to the repair path.</b:documentation>
      <b:incoming>N_p3_flow20</b:incoming>
      <b:outgoing>return_N_p3_alt_endfix</b:outgoing>
    </b:intermediateThrowEvent>
    <b:task id="N_p3_alt_block" name="Record unavailable prerequisite and blocked gate">
      <b:documentation>Example: Record simulator unavailable and identify the numerical gate and cases awaiting execution.</b:documentation>
      <b:incoming>N_p3_flow11</b:incoming>
      <b:incoming>N_p3_flow14</b:incoming>
      <b:incoming>N_p3_flow19</b:incoming>
      <b:outgoing>N_p3_flow21</b:outgoing>
    </b:task>
    <b:intermediateThrowEvent id="N_p3_alt_endblock" name="Gate blocked">
      <b:documentation>Example: Return the unavailable hardware result to the limited-report path.</b:documentation>
      <b:incoming>N_p3_flow21</b:incoming>
      <b:outgoing>return_N_p3_alt_endblock</b:outgoing>
    </b:intermediateThrowEvent>
    <b:task id="N_valid_check" name="Qualification outcome?">
      <b:documentation>Example: A wrong sum at width 65 needs repair. An unavailable simulator blocks the gate. Passing all requested gates allows the workflow to consider tuning.</b:documentation>
      <b:incoming>return_N_p3_z</b:incoming>
      <b:incoming>return_N_p3_alt_endfix</b:incoming>
      <b:incoming>return_N_p3_alt_endblock</b:incoming>
      <b:outgoing>N_flow23</b:outgoing>
    </b:task>
    <b:exclusiveGateway id="N_valid">
      <b:documentation>Example: Route the recorded decision. A wrong sum at width 65 needs repair. An unavailable simulator blocks the gate. Passing all requested gates allows the workflow to consider tuning.</b:documentation>
      <b:incoming>N_flow23</b:incoming>
      <b:outgoing>N_flow10</b:outgoing>
      <b:outgoing>N_flow12</b:outgoing>
      <b:outgoing>N_flow13</b:outgoing>
    </b:exclusiveGateway>
    <b:task id="N_repair" name="Repair from measured failure; preserve affected cases">
      <b:documentation>Example: For a mismatch at width 65, fix the tail path and retain width 65 in the regression matrix.</b:documentation>
      <b:incoming>N_flow10</b:incoming>
      <b:outgoing>N_flow11</b:outgoing>
    </b:task>
    <b:task id="N_tune_check" name="Optimization requested?">
      <b:documentation>Example: A correctness-only request goes to delivery. An explicit speed request with an agreed baseline and budget enters Phase 4 after qualification.</b:documentation>
      <b:incoming>N_flow13</b:incoming>
      <b:outgoing>N_flow24</b:outgoing>
    </b:task>
    <b:exclusiveGateway id="N_tune">
      <b:documentation>Example: Route the recorded decision. A correctness-only request goes to delivery. An explicit speed request with an agreed baseline and budget enters Phase 4 after qualification.</b:documentation>
      <b:incoming>N_flow24</b:incoming>
      <b:outgoing>N_flow14</b:outgoing>
      <b:outgoing>N_flow15</b:outgoing>
    </b:exclusiveGateway>
    <b:intermediateThrowEvent id="N_p4" name="Phase 4  /  Bounded performance tuning">
      <b:documentation>Example: With an agreed baseline and three attempts, compare one tile-width change at a time. Example: Begin with a qualified baseline and the user-agreed tuning budget.</b:documentation>
      <b:incoming>N_flow14</b:incoming>
      <b:outgoing>N_p4_flow0</b:outgoing>
    </b:intermediateThrowEvent>
    <b:task id="N_p4_a" name="Identify best correct incumbent and agreed budget">
      <b:documentation>Example: Select the accepted incumbent by hash and read its official baseline job and remaining attempt count.</b:documentation>
      <b:incoming>N_p4_flow0</b:incoming>
      <b:outgoing>N_p4_flow1</b:outgoing>
    </b:task>
    <b:task id="N_p4_b_check" name="Qualified proposal with comparable official measurement?">
      <b:documentation>Example: A reviewed, qualified proposal with comparable official timings can be compared. With only an incumbent, check the remaining budget.</b:documentation>
      <b:incoming>N_p4_flow1</b:incoming>
      <b:outgoing>N_p4_flow12</b:outgoing>
    </b:task>
    <b:exclusiveGateway id="N_p4_b">
      <b:documentation>Example: Route the recorded decision. A reviewed, qualified proposal with comparable official timings can be compared. With only an incumbent, check the remaining budget.</b:documentation>
      <b:incoming>N_p4_flow12</b:incoming>
      <b:outgoing>N_p4_flow4</b:outgoing>
      <b:outgoing>N_p4_flow5</b:outgoing>
    </b:exclusiveGateway>
    <b:task id="N_p4_c" name="Compare performance on preserved cases against incumbent">
      <b:documentation>Example: Compare both official jobs on the same cases, device and measurement protocol. Match the proposal and incumbent to their reviewed hashes and official jobs. Compare the same preserved cases, device and measurement protocol. Check every case for correctness and compare the official metric against observed timing variation.</b:documentation>
      <b:incoming>N_p4_flow4</b:incoming>
      <b:outgoing>N_p4_flow2</b:outgoing>
    </b:task>
    <b:task id="N_p4_d_check" name="All cases correct and official improvement exceeds noise?">
      <b:documentation>Example: If the agreed noise band is 2%, an otherwise comparable 1% gain keeps the incumbent. A 5% gain with every case correct can replace it.</b:documentation>
      <b:incoming>N_p4_flow2</b:incoming>
      <b:outgoing>N_p4_flow13</b:outgoing>
    </b:task>
    <b:exclusiveGateway id="N_p4_d">
      <b:documentation>Example: Route the recorded decision. If the agreed noise band is 2%, an otherwise comparable 1% gain keeps the incumbent. A 5% gain with every case correct can replace it.</b:documentation>
      <b:incoming>N_p4_flow13</b:incoming>
      <b:outgoing>N_p4_flow6</b:outgoing>
      <b:outgoing>N_p4_flow7</b:outgoing>
    </b:exclusiveGateway>
    <b:task id="N_p4_e" name="Retain improved candidate as incumbent">
      <b:documentation>Example: Save the correct, measurably faster variant hash and official job as the new incumbent.</b:documentation>
      <b:incoming>N_p4_flow6</b:incoming>
      <b:outgoing>N_p4_flow3</b:outgoing>
    </b:task>
    <b:task id="N_p4_alt_keep" name="Keep existing incumbent">
      <b:documentation>Example: Keep the previous kernel hash when the measured gain is within observed run-to-run variation.</b:documentation>
      <b:incoming>N_p4_flow7</b:incoming>
      <b:outgoing>N_p4_flow8</b:outgoing>
    </b:task>
    <b:task id="N_p4_f_check" name="Budget and another tuning attempt available?">
      <b:documentation>Example: With one attempt remaining and a tile-width hypothesis, propose another variant. At zero remaining attempts, deliver the incumbent.</b:documentation>
      <b:incoming>N_p4_flow3</b:incoming>
      <b:incoming>N_p4_flow5</b:incoming>
      <b:incoming>N_p4_flow8</b:incoming>
      <b:outgoing>N_p4_flow14</b:outgoing>
    </b:task>
    <b:exclusiveGateway id="N_p4_f">
      <b:documentation>Example: Route the recorded decision. With one attempt remaining and a tile-width hypothesis, propose another variant. At zero remaining attempts, deliver the incumbent.</b:documentation>
      <b:incoming>N_p4_flow14</b:incoming>
      <b:outgoing>N_p4_flow9</b:outgoing>
      <b:outgoing>N_p4_flow10</b:outgoing>
    </b:exclusiveGateway>
    <b:task id="N_p4_h" name="Change one lever: tiles, occupancy, buffering, layout, casts or specialization">
      <b:documentation>Example: Change only the tile width, preserve the case matrix and return the new kernel for fresh review.</b:documentation>
      <b:incoming>N_p4_flow9</b:incoming>
      <b:outgoing>N_p4_flow11</b:outgoing>
    </b:task>
    <b:intermediateThrowEvent id="N_p4_alt_endh" name="Proposal ready for review">
      <b:documentation>Example: Hand the changed bytes to Phase 2 for review before requalification and comparison.</b:documentation>
      <b:incoming>N_p4_flow11</b:incoming>
      <b:outgoing>return_N_p4_alt_endh</b:outgoing>
    </b:intermediateThrowEvent>
    <b:intermediateThrowEvent id="N_p4_z" name="Incumbent selected">
      <b:documentation>Example: With the budget exhausted, return the incumbent and its official evidence.</b:documentation>
      <b:incoming>N_p4_flow10</b:incoming>
      <b:outgoing>return_N_p4_z</b:outgoing>
    </b:intermediateThrowEvent>
    <b:task id="N_pick_check" name="Tuning outcome?">
      <b:documentation>Example: A changed tile width produces new bytes and returns to review. An exhausted budget returns the correct incumbent for delivery.</b:documentation>
      <b:incoming>return_N_p4_z</b:incoming>
      <b:incoming>return_N_p4_alt_endh</b:incoming>
      <b:outgoing>N_flow25</b:outgoing>
    </b:task>
    <b:exclusiveGateway id="N_pick">
      <b:documentation>Example: Route the recorded decision. A changed tile width produces new bytes and returns to review. An exhausted budget returns the correct incumbent for delivery.</b:documentation>
      <b:incoming>N_flow25</b:incoming>
      <b:outgoing>N_flow17</b:outgoing>
      <b:outgoing>N_flow18</b:outgoing>
    </b:exclusiveGateway>
    <b:task id="N_deliver" name="Deliver candidate, design, review, provenance, per-case results and available job links">
      <b:documentation>Example: Hand back kernel.py, design.md, the review of its SHA-256 and per-case results with any official job ID.</b:documentation>
      <b:incoming>N_flow15</b:incoming>
      <b:incoming>N_flow18</b:incoming>
      <b:outgoing>N_flow19</b:outgoing>
    </b:task>
    <b:endEvent id="N_z">
      <b:documentation>Example: The caller hands back the selected kernel and the report for the requested cases.</b:documentation>
      <b:incoming>N_flow19</b:incoming>
    </b:endEvent>
    <b:task id="N_limited" name="Report blocked or limited scope with diagnostic">
      <b:documentation>Example: Report the missing AscTile import, the selected interpreter and the gates left unrun.</b:documentation>
      <b:incoming>N_flow3</b:incoming>
      <b:incoming>N_flow7</b:incoming>
      <b:incoming>N_flow12</b:incoming>
      <b:outgoing>N_flow20</b:outgoing>
    </b:task>
    <b:endEvent id="N_limitend" name="Limited or blocked report delivered">
      <b:documentation>Example: The user receives the exact runtime diagnostic and a report identifying numerical qualification as blocked.</b:documentation>
      <b:incoming>N_flow20</b:incoming>
    </b:endEvent>
