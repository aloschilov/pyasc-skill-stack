{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": ["./skills"]
  },
  "mcp": {
    "cann-bench-site": {
      "type": "local",
      "command": [
        "/bin/bash",
        "-c",
        "exec ./integrations/cannbench/site-mcp.sh"
      ],
      "enabled": true,
      "timeout": 120000
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "bash": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "skill": "allow",
    "task": "allow",
    "external_directory": {
      "*": "deny",
      "~/workspace/pyasc/*": "allow",
      "~/workspace/pyasc-skill-stack/*": "allow"
    }
  }
}
