{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode gateway",
      "options": {
        "baseURL": "{env:OPENCODE_BASE_URL}",
        "apiKey": "{env:OPENCODE_API_KEY}"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash (low reasoning)",
          "options": {
            "thinking": {
              "type": "enabled"
            },
            "reasoningEffort": "low"
          },
          "limit": {
            "context": 256000,
            "output": 32768
          }
        }
      }
    }
  },
  "model": "gateway/deepseek-v4.1-flash",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "bash": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "skill": "allow",
    "task": "allow",
    "external_directory": {
      "*": "deny"
    }
  }
}
