{"type":"tool_use","timestamp":1788352644851,"sessionID":"ses_f9de3a50effeMz6KmFLbj4vnw3","part":{"type":"tool","tool":"read","callID":"call_784a94ac8b4e49c99154878a","state":{"status":"completed","input":{"filePath":"/home/aloschilov/workspace/pyasc-skill-stack/integrations/cannbench/workers/.scratch/staged_20260902_153337_rms_norm/candidate.py"},"output":"<path>/home/aloschilov/workspace/pyasc-skill-stack/integrations/cannbench/workers/.scratch/staged_20260902_153337_rms_norm/candidate.py</path>\n<type>file</type>\n<content>\n1: \"\"\"CANN Bench RmsNorm interface implemented as a pyasc asc2 kernel.\n2: \n3: Kernel design (two-pass streaming per row):\n4:   - Pass 1: stream D in TILE_D chunks, accumulate sum-of-squares in f32 scalar.\n5:   - Scalar compute: inv_rms = rsqrt(acc * inv_D + epsilon).\n6:   - Pass 2: re-stream D chunks, reload x and gamma, emit y = x * inv_rms * gamma.\n7:   - f16/bf16 inputs promoted to f32 inside the kernel for precision.\n8:   - Grid-stride outer loop over rows across 72 AIV cores.\n9:   - TILE_D = 1024 keeps UB well under 253 952 bytes (single-buffered, no unroll).\n10: \"\"\"\n11: \n12: import torch\n13: \n14: import asc\n15: import asc2\n16: \n17: from ._pyasc_runtime import ensure_npu_platform\n18: \n19: _TILE_D = 1024\n20: _MAX_CORES = 72\n21: \n22: \n23: @asc2.jit\n24: def _rms_norm_kernel(x_ptr: asc.GlobalAddress, gamma_ptr: asc.GlobalAddress,\n25:                      out_ptr: asc.GlobalAddress,\n26:                      S: int, D: int, num_d_tiles: int,\n27:                      epsilon: float, inv_D: float,\n28:                      tile_d: asc.ConstExpr[int]):\n29:     x_gm = asc2.global_tensor(x_ptr, [S * D])\n30:     g_gm = asc2.global_tensor(gamma_ptr, [D])\n31:     o_gm = asc2.global_tensor(out_ptr, [S * D])\n32: \n33:     for r in asc2.range(asc2.block_idx(), S, asc2.block_num()):\n34:         row = r * D\n35:         acc = asc2.reduce_sum(asc2.full([1, 64], 0.0, dtype=asc.float32))\n36:         for dt in asc2.range(num_d_tiles):\n37:             od = dt * tile_d\n38:             n = tile_d if od + tile_d <= D else D - od\n39:             x = asc2.copy_in(x_gm, [row + od], [tile_d], real_shape=[n])\n40:             xf = x.to(asc.float32)\n41:             acc = acc + asc2.reduce_sum(xf * xf)\n42:         inv_rms_tile = asc2.rsqrt(asc2.full([tile_d], acc * inv_D + epsilon, dtype=asc.float32))\n43: \n44:         for dt in asc2.range(num_d_tiles):\n45:             od = dt * tile_d\n46:             n = tile_d if od + tile_d <= D else D - od\n47:             x = asc2.copy_in(x_gm, [row + od], [tile_d], real_shape=[n])\n48:             g = asc2.copy_in(g_gm, [od], [tile_d], real_shape=[n])\n49:             xf = x.to(asc.float32)\n50:             gf = g.to(asc.float32)\n51:             y = xf * inv_rms_tile * gf\n52:             asc2.copy_out(y.to(x.dtype), o_gm, [row + od], real_shape=[n])\n53: \n54: \n55: def rms_norm(x: torch.Tensor, gamma: torch.Tensor,\n56:              epsilon: float = 1e-6) -> torch.Tensor:\n57:     ensure_npu_platform()\n58:     if not x.is_contiguous():\n59:         x = x.contiguous()\n60:     if not gamma.is_contiguous():\n61:         gamma = gamma.contiguous()\n62:     D = x.shape[-1]\n63:     S = x.numel() // D\n64:     out = torch.empty_like(x)\n65:     if S == 0 or D == 0:\n66:         return out\n67:     tile_d = _TILE_D\n68:     num_d_tiles = (D + tile_d - 1) // tile_d\n69:     inv_D = 1.0 / float(D)\n70:     cores = min(_MAX_CORES, S)\n71:     _rms_norm_kernel[cores](x, gamma, out, S, D, num_d_tiles,\n72:                             epsilon, inv_D, tile_d)\n73:     return out\n\n(End of file - total 73 lines)\n</content>","metadata":{"preview":"\"\"\"CANN Bench RmsNorm interface implemented as a pyasc asc2 kernel.\n\nKernel design (two-pass streaming per row):\n  - Pass 1: stream D in TILE_D chunks, accumulate sum-of-squares in f32 scalar.\n  - Scalar compute: inv_rms = rsqrt(acc * inv_D + epsilon).\n  - Pass 2: re-stream D chunks, reload x and gamma, emit y = x * inv_rms * gamma.\n  - f16/bf16 inputs promoted to f32 inside the kernel for precision.\n  - Grid-stride outer loop over rows across 72 AIV cores.\n  - TILE_D = 1024 keeps UB well under 253 952 bytes (single-buffered, no unroll).\n\"\"\"\n\nimport torch\n\nimport asc\nimport asc2\n\nfrom ._pyasc_runtime import ensure_npu_platform\n\n_TILE_D = 1024\n_MAX_CORES = 72","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/aloschilov/workspace/pyasc-skill-stack/integrations/cannbench/workers/.scratch/staged_20260902_153337_rms_norm/candidate.py","text":"\"\"\"CANN Bench RmsNorm interface implemented as a pyasc asc2 kernel.\n\nKernel design (two-pass streaming per row):\n  - Pass 1: stream D in TILE_D chunks, accumulate sum-of-squares in f32 scalar.\n  - Scalar compute: inv_rms = rsqrt(acc * inv_D + epsilon).\n  - Pass 2: re-stream D chunks, reload x and gamma, emit y = x * inv_rms * gamma.\n  - f16/bf16 inputs promoted to f32 inside the kernel for precision.\n  - Grid-stride outer loop over rows across 72 AIV cores.\n  - TILE_D = 1024 keeps UB well under 253 952 bytes (single-buffered, no unroll).\n\"\"\"\n\nimport torch\n\nimport asc\nimport asc2\n\nfrom ._pyasc_runtime import ensure_npu_platform\n\n_TILE_D = 1024\n_MAX_CORES = 72\n\n\n@asc2.jit\ndef _rms_norm_kernel(x_ptr: asc.GlobalAddress, gamma_ptr: asc.GlobalAddress,\n                     out_ptr: asc.GlobalAddress,\n                     S: int, D: int, num_d_tiles: int,\n                     epsilon: float, inv_D: float,\n                     tile_d: asc.ConstExpr[int]):\n    x_gm = asc2.global_tensor(x_ptr, [S * D])\n    g_gm = asc2.global_tensor(gamma_ptr, [D])\n    o_gm = asc2.global_tensor(out_ptr, [S * D])\n\n    for r in asc2.range(asc2.block_idx(), S, asc2.block_num()):\n        row = r * D\n        acc = asc2.reduce_sum(asc2.full([1, 64], 0.0, dtype=asc.float32))\n        for dt in asc2.range(num_d_tiles):\n            od = dt * tile_d\n            n = tile_d if od + tile_d <= D else D - od\n            x = asc2.copy_in(x_gm, [row + od], [tile_d], real_shape=[n])\n            xf = x.to(asc.float32)\n            acc = acc + asc2.reduce_sum(xf * xf)\n        inv_rms_tile = asc2.rsqrt(asc2.full([tile_d], acc * inv_D + epsilon, dtype=asc.float32))\n\n        for dt in asc2.range(num_d_tiles):\n            od = dt * tile_d\n            n = tile_d if od + tile_d <= D else D - od\n            x = asc2.copy_in(x_gm, [row + od], [tile_d], real_shape=[n])\n            g = asc2.copy_in(g_gm, [od], [tile_d], real_shape=[n])\n            xf = x.to(asc.float32)\n            gf = g.to(asc.float32)\n            y = xf * inv_rms_tile * gf\n            asc2.copy_out(y.to(x.dtype), o_gm, [row + od], real_shape=[n])\n\n\ndef rms_norm(x: torch.Tensor, gamma: torch.Tensor,\n             epsilon: float = 1e-6) -> torch.Tensor:\n    ensure_npu_platform()\n    if not x.is_contiguous():\n        x = x.contiguous()\n    if not gamma.is_contiguous():\n        gamma = gamma.contiguous()\n    D = x.shape[-1]\n    S = x.numel() // D\n    out = torch.empty_like(x)\n    if S == 0 or D == 0:\n        return out\n    tile_d = _TILE_D\n    num_d_tiles = (D + tile_d - 1) // tile_d\n    inv_D = 1.0 / float(D)\n    cores = min(_MAX_CORES, S)\n    _rms_norm_kernel[cores](x, gamma, out, S, D, num_d_tiles,\n                            epsilon, inv_D, tile_d)\n    return out","lineStart":1,"lineEnd":73,"totalLines":73,"truncated":false}},"title":"integrations/cannbench/workers/.scratch/staged_20260902_153337_rms_norm/candidate.py","time":{"start":1788352644845,"end":1788352644850}},"id":"prt_0621fc23a001QKWtMDkgiJYD8C","sessionID":"ses_f9de3a50effeMz6KmFLbj4vnw3","messageID":"msg_0621fa645001kRmzZebZCac3Sk"}}
