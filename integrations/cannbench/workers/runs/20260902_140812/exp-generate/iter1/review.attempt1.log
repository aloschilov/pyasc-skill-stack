{"type":"tool_use","timestamp":1788347610496,"sessionID":"ses_f9e2d34cdffe0eE32xFqUVyL7D","part":{"type":"tool","tool":"read","callID":"call_d896a94aadb847f29f597cf7","state":{"status":"completed","input":{"filePath":"/home/aloschilov/workspace/pyasc-skill-stack/integrations/cannbench/workers/.scratch/20260902_140812/exp-generate/candidate.py"},"output":"<path>/home/aloschilov/workspace/pyasc-skill-stack/integrations/cannbench/workers/.scratch/20260902_140812/exp-generate/candidate.py</path>\n<type>file</type>\n<content>\n1: \"\"\"CANN Bench Exp interface implemented as a pyasc asc2 kernel.\n2: \n3: Kernel design (pyasc-api-patterns Pattern A, grid-stride variant):\n4:   - 1-D flatten; each block strides over tiles so any element count works.\n5:   - Tail tiles handled with ``real_shape`` loads/stores (no host padding).\n6:   - f16/bf16 inputs are promoted to f32 inside the kernel for precision.\n7:   - Host selects between two compiled tile sizes: wide (3072) when the\n8:     element count fills all 72 cores, narrow (1024) for small shapes.\n9:   - Unified formula: factor = 1.0 (base<=0) or ln(base) (base>0);\n10:     arg = (xf * scale + shift) * factor; y = exp(arg).\n11:   - IEEE inf/nan propagates correctly through asc2.exp; no host branches.\n12: \"\"\"\n13: \n14: import math\n15: \n16: import torch\n17: \n18: import asc\n19: import asc2\n20: \n21: from ._pyasc_runtime import ensure_npu_platform\n22: \n23: _WIDE_TILE = 3072\n24: _NARROW_TILE = 1024\n25: _MAX_CORES = 72\n26: \n27: \n28: @asc2.jit\n29: def _exp_kernel(x_ptr: asc.GlobalAddress, out_ptr: asc.GlobalAddress,\n30:                 size: int, num_tiles: int,\n31:                 scale: float, shift: float, factor: float,\n32:                 tile_size: asc.ConstExpr[int]):\n33:     x_gm = asc2.global_tensor(x_ptr, [size])\n34:     out_gm = asc2.global_tensor(out_ptr, [size])\n35:     for t in asc2.range(asc2.block_idx(), num_tiles, asc2.block_num(),\n36:                         unroll_factor=2):\n37:         off = t * tile_size\n38:         n = tile_size if off + tile_size <= size else size - off\n39:         x = asc2.copy_in(x_gm, [off], [tile_size], real_shape=[n])\n40:         xf = x.to(asc.float32)\n41:         arg = (xf * scale + shift) * factor\n42:         y = asc2.exp(arg)\n43:         asc2.copy_out(y.to(x.dtype), out_gm, [off], real_shape=[n])\n44: \n45: \n46: def exp(x: torch.Tensor, base: float = -1.0, scale: float = 1.0,\n47:         shift: float = 0.0) -> torch.Tensor:\n48:     \"\"\"Generalized exponential: y = exp((x * scale + shift) * ln(base)).\"\"\"\n49:     ensure_npu_platform()\n50:     if not x.is_contiguous():\n51:         x = x.contiguous()\n52:     out = torch.empty_like(x)\n53:     size = x.numel()\n54:     if size == 0:\n55:         return out\n56:     if base > 0.0:\n57:         factor = math.log(base)\n58:     else:\n59:         factor = 1.0\n60:     if size >= _MAX_CORES * _WIDE_TILE:\n61:         num_tiles = asc.ceildiv(size, _WIDE_TILE)\n62:         cores = min(_MAX_CORES, num_tiles)\n63:         _exp_kernel[cores](x, out, size, num_tiles, scale, shift, factor,\n64:                            _WIDE_TILE)\n65:     else:\n66:         num_tiles = asc.ceildiv(size, _NARROW_TILE)\n67:         cores = min(_MAX_CORES, num_tiles)\n68:         _exp_kernel[cores](x, out, size, num_tiles, scale, shift, factor,\n69:                            _NARROW_TILE)\n70:     return out\n\n(End of file - total 70 lines)\n</content>","metadata":{"preview":"\"\"\"CANN Bench Exp interface implemented as a pyasc asc2 kernel.\n\nKernel design (pyasc-api-patterns Pattern A, grid-stride variant):\n  - 1-D flatten; each block strides over tiles so any element count works.\n  - Tail tiles handled with ``real_shape`` loads/stores (no host padding).\n  - f16/bf16 inputs are promoted to f32 inside the kernel for precision.\n  - Host selects between two compiled tile sizes: wide (3072) when the\n    element count fills all 72 cores, narrow (1024) for small shapes.\n  - Unified formula: factor = 1.0 (base<=0) or ln(base) (base>0);\n    arg = (xf * scale + shift) * factor; y = exp(arg).\n  - IEEE inf/nan propagates correctly through asc2.exp; no host branches.\n\"\"\"\n\nimport math\n\nimport torch\n\nimport asc\nimport asc2\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/aloschilov/workspace/pyasc-skill-stack/integrations/cannbench/workers/.scratch/20260902_140812/exp-generate/candidate.py","text":"\"\"\"CANN Bench Exp interface implemented as a pyasc asc2 kernel.\n\nKernel design (pyasc-api-patterns Pattern A, grid-stride variant):\n  - 1-D flatten; each block strides over tiles so any element count works.\n  - Tail tiles handled with ``real_shape`` loads/stores (no host padding).\n  - f16/bf16 inputs are promoted to f32 inside the kernel for precision.\n  - Host selects between two compiled tile sizes: wide (3072) when the\n    element count fills all 72 cores, narrow (1024) for small shapes.\n  - Unified formula: factor = 1.0 (base<=0) or ln(base) (base>0);\n    arg = (xf * scale + shift) * factor; y = exp(arg).\n  - IEEE inf/nan propagates correctly through asc2.exp; no host branches.\n\"\"\"\n\nimport math\n\nimport torch\n\nimport asc\nimport asc2\n\nfrom ._pyasc_runtime import ensure_npu_platform\n\n_WIDE_TILE = 3072\n_NARROW_TILE = 1024\n_MAX_CORES = 72\n\n\n@asc2.jit\ndef _exp_kernel(x_ptr: asc.GlobalAddress, out_ptr: asc.GlobalAddress,\n                size: int, num_tiles: int,\n                scale: float, shift: float, factor: float,\n                tile_size: asc.ConstExpr[int]):\n    x_gm = asc2.global_tensor(x_ptr, [size])\n    out_gm = asc2.global_tensor(out_ptr, [size])\n    for t in asc2.range(asc2.block_idx(), num_tiles, asc2.block_num(),\n                        unroll_factor=2):\n        off = t * tile_size\n        n = tile_size if off + tile_size <= size else size - off\n        x = asc2.copy_in(x_gm, [off], [tile_size], real_shape=[n])\n        xf = x.to(asc.float32)\n        arg = (xf * scale + shift) * factor\n        y = asc2.exp(arg)\n        asc2.copy_out(y.to(x.dtype), out_gm, [off], real_shape=[n])\n\n\ndef exp(x: torch.Tensor, base: float = -1.0, scale: float = 1.0,\n        shift: float = 0.0) -> torch.Tensor:\n    \"\"\"Generalized exponential: y = exp((x * scale + shift) * ln(base)).\"\"\"\n    ensure_npu_platform()\n    if not x.is_contiguous():\n        x = x.contiguous()\n    out = torch.empty_like(x)\n    size = x.numel()\n    if size == 0:\n        return out\n    if base > 0.0:\n        factor = math.log(base)\n    else:\n        factor = 1.0\n    if size >= _MAX_CORES * _WIDE_TILE:\n        num_tiles = asc.ceildiv(size, _WIDE_TILE)\n        cores = min(_MAX_CORES, num_tiles)\n        _exp_kernel[cores](x, out, size, num_tiles, scale, shift, factor,\n                           _WIDE_TILE)\n    else:\n        num_tiles = asc.ceildiv(size, _NARROW_TILE)\n        cores = min(_MAX_CORES, num_tiles)\n        _exp_kernel[cores](x, out, size, num_tiles, scale, shift, factor,\n                           _NARROW_TILE)\n    return out","lineStart":1,"lineEnd":70,"totalLines":70,"truncated":false}},"title":"integrations/cannbench/workers/.scratch/20260902_140812/exp-generate/candidate.py","time":{"start":1788347610489,"end":1788347610494}},"id":"prt_061d2f3d0001Xe0YP9jhQfFXMK","sessionID":"ses_f9e2d34cdffe0eE32xFqUVyL7D","messageID":"msg_061d2eb45001MmbHeUBgWo7fpn"}}
