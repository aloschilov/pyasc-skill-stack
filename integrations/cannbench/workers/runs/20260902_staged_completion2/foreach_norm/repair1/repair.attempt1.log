{"type":"tool_use","timestamp":1788353700966,"sessionID":"ses_f9dd033c6ffebNyiS1Y7sf51fp","part":{"type":"tool","tool":"read","callID":"call_c6d61af2d72343aca79b4d83","state":{"status":"completed","input":{"filePath":"/home/aloschilov/workspace/pyasc-skill-stack/integrations/cannbench/workers/.scratch/staged_20260902_155449_foreach_norm/candidate.py"},"output":"<path>/home/aloschilov/workspace/pyasc-skill-stack/integrations/cannbench/workers/.scratch/staged_20260902_155449_foreach_norm/candidate.py</path>\n<type>file</type>\n<content>\n1: \"\"\"CANN Bench ForeachNorm: per-tensor p-norm via pyasc asc2 kernels.\n2: \n3: Kernels:\n4:   _k_sum_abs  : p=1, TILE=2048, reduce_sum(abs(xf))\n5:   _k_sum_sq   : p=2, TILE=2048, reduce_sum(xf*xf), final=sqrt\n6:   _k_max_abs  : p=inf, TILE=2048, reduce_max(abs(xf))\n7:   _k_sum_gen  : general p, TILE=1024, reduce_sum(exp(log(abs(xf))*p)), final=exp(log(S)/p)\n8: \n9: All accumulation in f32; cross-core via atomic_add / atomic_max into a\n10: zero-seeded global buffer; second single-core pass applies final transform,\n11: casts to input dtype, and writes to an 8-element target-dtype buffer.\n12: \"\"\"\n13: \n14: import math\n15: import torch\n16: \n17: import asc\n18: import asc2\n19: \n20: from ._pyasc_runtime import ensure_npu_platform\n21: \n22: \n23: _WIDE_TILE = 2048\n24: _NARROW_TILE = 1024\n25: _MAX_CORES = 72\n26: _INF = math.inf\n27: \n28: \n29: @asc2.jit\n30: def _k_sum_abs(x_ptr: asc.GlobalAddress, out_ptr: asc.GlobalAddress,\n31:                size: int, num_tiles: int, tile_size: asc.ConstExpr[int]):\n32:     x_gm = asc2.global_tensor(x_ptr, [size])\n33:     out_gm = asc2.global_tensor(out_ptr, [8])\n34:     acc = asc2.reduce_sum(asc2.full([1, 64], 0.0, dtype=asc.float32))\n35:     for t in asc2.range(asc2.block_idx(), num_tiles, asc2.block_num(), unroll_factor=2):\n36:         off = t * tile_size\n37:         n = tile_size if off + tile_size <= size else size - off\n38:         x = asc2.copy_in(x_gm, [off], [tile_size], real_shape=[n])\n39:         xf = x.to(asc.float32)\n40:         a = asc2.abs(xf)\n41:         acc = acc + asc2.reduce_sum(a)\n42:     s = asc2.full([8], acc, dtype=asc.float32)\n43:     asc2.atomic_add(s, out_gm, [0])\n44: \n45: \n46: @asc2.jit\n47: def _k_sum_sq(x_ptr: asc.GlobalAddress, out_ptr: asc.GlobalAddress,\n48:               size: int, num_tiles: int, tile_size: asc.ConstExpr[int]):\n49:     x_gm = asc2.global_tensor(x_ptr, [size])\n50:     out_gm = asc2.global_tensor(out_ptr, [8])\n51:     acc = asc2.reduce_sum(asc2.full([1, 64], 0.0, dtype=asc.float32))\n52:     for t in asc2.range(asc2.block_idx(), num_tiles, asc2.block_num(), unroll_factor=2):\n53:         off = t * tile_size\n54:         n = tile_size if off + tile_size <= size else size - off\n55:         x = asc2.copy_in(x_gm, [off], [tile_size], real_shape=[n])\n56:         xf = x.to(asc.float32)\n57:         sq = xf * xf\n58:         acc = acc + asc2.reduce_sum(sq)\n59:     s = asc2.full([8], acc, dtype=asc.float32)\n60:     asc2.atomic_add(s, out_gm, [0])\n61: \n62: \n63: @asc2.jit\n64: def _k_max_abs(x_ptr: asc.GlobalAddress, out_ptr: asc.GlobalAddress,\n65:                size: int, num_tiles: int, tile_size: asc.ConstExpr[int]):\n66:     x_gm = asc2.global_tensor(x_ptr, [size])\n67:     out_gm = asc2.global_tensor(out_ptr, [8])\n68:     acc = asc2.reduce_max(asc2.full([1, 64], 0.0, dtype=asc.float32))\n69:     for t in asc2.range(asc2.block_idx(), num_tiles, asc2.block_num(), unroll_factor=2):\n70:         off = t * tile_size\n71:         n = tile_size if off + tile_size <= size else size - off\n72:         x = asc2.copy_in(x_gm, [off], [tile_size], real_shape=[n])\n73:         xf = x.to(asc.float32)\n74:         a = asc2.abs(xf)\n75:         m = asc2.reduce_max(a)\n76:         acc = asc2.maximum(acc, m)\n77:     s = asc2.full([8], acc, dtype=asc.float32)\n78:     asc2.atomic_max(s, out_gm, [0])\n79: \n80: \n81: @asc2.jit\n82: def _k_sum_gen(x_ptr: asc.GlobalAddress, out_ptr: asc.GlobalAddress,\n83:                size: int, num_tiles: int, p: float,\n84:                tile_size: asc.ConstExpr[int]):\n85:     x_gm = asc2.global_tensor(x_ptr, [size])\n86:     out_gm = asc2.global_tensor(out_ptr, [8])\n87:     acc = asc2.reduce_sum(asc2.full([1, 64], 0.0, dtype=asc.float32))\n88:     for t in asc2.range(asc2.block_idx(), num_tiles, asc2.block_num(), unroll_factor=2):\n89:         off = t * tile_size\n90:         n = tile_size if off + tile_size <= size else size - off\n91:         x = asc2.copy_in(x_gm, [off], [tile_size], real_shape=[n])\n92:         xf = x.to(asc.float32)\n93:         a = asc2.abs(xf)\n94:         log_a = asc2.log(a)\n95:         log_a_p = log_a * p\n96:         e = asc2.exp(log_a_p)\n97:         acc = acc + asc2.reduce_sum(e)\n98:     s = asc2.full([8], acc, dtype=asc.float32)\n99:     asc2.atomic_add(s, out_gm, [0])\n100: \n101: \n102: @asc2.jit\n103: def _k_final_identity(buf_ptr: asc.GlobalAddress, out_ptr: asc.GlobalAddress,\n104:                       x_ptr: asc.GlobalAddress):\n105:     buf_gm = asc2.global_tensor(buf_ptr, [8])\n106:     out_gm = asc2.global_tensor(out_ptr, [8])\n107:     x_gm = asc2.global_tensor(x_ptr, [8])\n108:     b = asc2.copy_in(buf_gm, [0], [8], real_shape=[8])\n109:     x_ref = asc2.copy_in(x_gm, [0], [8], real_shape=[8])\n110:     asc2.copy_out(b.to(x_ref.dtype), out_gm, [0], real_shape=[8])\n111: \n112: \n113: @asc2.jit\n114: def _k_final_sqrt(buf_ptr: asc.GlobalAddress, out_ptr: asc.GlobalAddress,\n115:                   x_ptr: asc.GlobalAddress):\n116:     buf_gm = asc2.global_tensor(buf_ptr, [8])\n117:     out_gm = asc2.global_tensor(out_ptr, [8])\n118:     x_gm = asc2.global_tensor(x_ptr, [8])\n119:     b = asc2.copy_in(buf_gm, [0], [8], real_shape=[8])\n120:     x_ref = asc2.copy_in(x_gm, [0], [8], real_shape=[8])\n121:     r = asc2.sqrt(b)\n122:     asc2.copy_out(r.to(x_ref.dtype), out_gm, [0], real_shape=[8])\n123: \n124: \n125: @asc2.jit\n126: def _k_final_power(buf_ptr: asc.GlobalAddress, out_ptr: asc.GlobalAddress,\n127:                    x_ptr: asc.GlobalAddress, p: float):\n128:     buf_gm = asc2.global_tensor(buf_ptr, [8])\n129:     out_gm = asc2.global_tensor(out_ptr, [8])\n130:     x_gm = asc2.global_tensor(x_ptr, [8])\n131:     b = asc2.copy_in(buf_gm, [0], [8], real_shape=[8])\n132:     x_ref = asc2.copy_in(x_gm, [0], [8], real_shape=[8])\n133:     log_s = asc2.log(b)\n134:     log_s_div_p = log_s / p\n135:     r = asc2.exp(log_s_div_p)\n136:     asc2.copy_out(r.to(x_ref.dtype), out_gm, [0], real_shape=[8])\n137: \n138: \n139: def _launch_norm(x: torch.Tensor, scalar: float):\n140:     size = x.numel()\n141:     buf = torch.zeros([8], dtype=torch.float32, device=x.device)\n142:     out8 = torch.empty(8, dtype=x.dtype, device=x.device)\n143: \n144:     if scalar == _INF:\n145:         tile = _WIDE_TILE\n146:         num_tiles = asc.ceildiv(size, tile)\n147:         cores = min(_MAX_CORES, num_tiles) if num_tiles > 0 else 1\n148:         _k_max_abs[cores](x, buf, size, num_tiles, tile)\n149:         _k_final_identity[1](buf, out8, x)\n150:     elif scalar == 1.0:\n151:         tile = _WIDE_TILE\n152:         num_tiles = asc.ceildiv(size, tile)\n153:         cores = min(_MAX_CORES, num_tiles) if num_tiles > 0 else 1\n154:         _k_sum_abs[cores](x, buf, size, num_tiles, tile)\n155:         _k_final_identity[1](buf, out8, x)\n156:     elif scalar == 2.0:\n157:         tile = _WIDE_TILE\n158:         num_tiles = asc.ceildiv(size, tile)\n159:         cores = min(_MAX_CORES, num_tiles) if num_tiles > 0 else 1\n160:         _k_sum_sq[cores](x, buf, size, num_tiles, tile)\n161:         _k_final_sqrt[1](buf, out8, x)\n162:     else:\n163:         tile = _NARROW_TILE\n164:         num_tiles = asc.ceildiv(size, tile)\n165:         cores = min(_MAX_CORES, num_tiles) if num_tiles > 0 else 1\n166:         _k_sum_gen[cores](x, buf, size, num_tiles, scalar, tile)\n167:         _k_final_power[1](buf, out8, x, scalar)\n168: \n169:     return out8.narrow(0, 0, 1).reshape(())\n170: \n171: \n172: def foreach_norm(x: list, scalar: float) -> list:\n173:     ensure_npu_platform()\n174:     results = []\n175:     for t in x:\n176:         tc = t.contiguous() if not t.is_contiguous() else t\n177:         result = _launch_norm(tc, scalar)\n178:         results.append(result)\n179:     return results\n\n(End of file - total 179 lines)\n</content>","metadata":{"preview":"\"\"\"CANN Bench ForeachNorm: per-tensor p-norm via pyasc asc2 kernels.\n\nKernels:\n  _k_sum_abs  : p=1, TILE=2048, reduce_sum(abs(xf))\n  _k_sum_sq   : p=2, TILE=2048, reduce_sum(xf*xf), final=sqrt\n  _k_max_abs  : p=inf, TILE=2048, reduce_max(abs(xf))\n  _k_sum_gen  : general p, TILE=1024, reduce_sum(exp(log(abs(xf))*p)), final=exp(log(S)/p)\n\nAll accumulation in f32; cross-core via atomic_add / atomic_max into a\nzero-seeded global buffer; second single-core pass applies final transform,\ncasts to input dtype, and writes to an 8-element target-dtype buffer.\n\"\"\"\n\nimport math\nimport torch\n\nimport asc\nimport asc2\n\nfrom ._pyasc_runtime import ensure_npu_platform","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/aloschilov/workspace/pyasc-skill-stack/integrations/cannbench/workers/.scratch/staged_20260902_155449_foreach_norm/candidate.py","text":"\"\"\"CANN Bench ForeachNorm: per-tensor p-norm via pyasc asc2 kernels.\n\nKernels:\n  _k_sum_abs  : p=1, TILE=2048, reduce_sum(abs(xf))\n  _k_sum_sq   : p=2, TILE=2048, reduce_sum(xf*xf), final=sqrt\n  _k_max_abs  : p=inf, TILE=2048, reduce_max(abs(xf))\n  _k_sum_gen  : general p, TILE=1024, reduce_sum(exp(log(abs(xf))*p)), final=exp(log(S)/p)\n\nAll accumulation in f32; cross-core via atomic_add / atomic_max into a\nzero-seeded global buffer; second single-core pass applies final transform,\ncasts to input dtype, and writes to an 8-element target-dtype buffer.\n\"\"\"\n\nimport math\nimport torch\n\nimport asc\nimport asc2\n\nfrom ._pyasc_runtime import ensure_npu_platform\n\n\n_WIDE_TILE = 2048\n_NARROW_TILE = 1024\n_MAX_CORES = 72\n_INF = math.inf\n\n\n@asc2.jit\ndef _k_sum_abs(x_ptr: asc.GlobalAddress, out_ptr: asc.GlobalAddress,\n               size: int, num_tiles: int, tile_size: asc.ConstExpr[int]):\n    x_gm = asc2.global_tensor(x_ptr, [size])\n    out_gm = asc2.global_tensor(out_ptr, [8])\n    acc = asc2.reduce_sum(asc2.full([1, 64], 0.0, dtype=asc.float32))\n    for t in asc2.range(asc2.block_idx(), num_tiles, asc2.block_num(), unroll_factor=2):\n        off = t * tile_size\n        n = tile_size if off + tile_size <= size else size - off\n        x = asc2.copy_in(x_gm, [off], [tile_size], real_shape=[n])\n        xf = x.to(asc.float32)\n        a = asc2.abs(xf)\n        acc = acc + asc2.reduce_sum(a)\n    s = asc2.full([8], acc, dtype=asc.float32)\n    asc2.atomic_add(s, out_gm, [0])\n\n\n@asc2.jit\ndef _k_sum_sq(x_ptr: asc.GlobalAddress, out_ptr: asc.GlobalAddress,\n              size: int, num_tiles: int, tile_size: asc.ConstExpr[int]):\n    x_gm = asc2.global_tensor(x_ptr, [size])\n    out_gm = asc2.global_tensor(out_ptr, [8])\n    acc = asc2.reduce_sum(asc2.full([1, 64], 0.0, dtype=asc.float32))\n    for t in asc2.range(asc2.block_idx(), num_tiles, asc2.block_num(), unroll_factor=2):\n        off = t * tile_size\n        n = tile_size if off + tile_size <= size else size - off\n        x = asc2.copy_in(x_gm, [off], [tile_size], real_shape=[n])\n        xf = x.to(asc.float32)\n        sq = xf * xf\n        acc = acc + asc2.reduce_sum(sq)\n    s = asc2.full([8], acc, dtype=asc.float32)\n    asc2.atomic_add(s, out_gm, [0])\n\n\n@asc2.jit\ndef _k_max_abs(x_ptr: asc.GlobalAddress, out_ptr: asc.GlobalAddress,\n               size: int, num_tiles: int, tile_size: asc.ConstExpr[int]):\n    x_gm = asc2.global_tensor(x_ptr, [size])\n    out_gm = asc2.global_tensor(out_ptr, [8])\n    acc = asc2.reduce_max(asc2.full([1, 64], 0.0, dtype=asc.float32))\n    for t in asc2.range(asc2.block_idx(), num_tiles, asc2.block_num(), unroll_factor=2):\n        off = t * tile_size\n        n = tile_size if off + tile_size <= size else size - off\n        x = asc2.copy_in(x_gm, [off], [tile_size], real_shape=[n])\n        xf = x.to(asc.float32)\n        a = asc2.abs(xf)\n        m = asc2.reduce_max(a)\n        acc = asc2.maximum(acc, m)\n    s = asc2.full([8], acc, dtype=asc.float32)\n    asc2.atomic_max(s, out_gm, [0])\n\n\n@asc2.jit\ndef _k_sum_gen(x_ptr: asc.GlobalAddress, out_ptr: asc.GlobalAddress,\n               size: int, num_tiles: int, p: float,\n               tile_size: asc.ConstExpr[int]):\n    x_gm = asc2.global_tensor(x_ptr, [size])\n    out_gm = asc2.global_tensor(out_ptr, [8])\n    acc = asc2.reduce_sum(asc2.full([1, 64], 0.0, dtype=asc.float32))\n    for t in asc2.range(asc2.block_idx(), num_tiles, asc2.block_num(), unroll_factor=2):\n        off = t * tile_size\n        n = tile_size if off + tile_size <= size else size - off\n        x = asc2.copy_in(x_gm, [off], [tile_size], real_shape=[n])\n        xf = x.to(asc.float32)\n        a = asc2.abs(xf)\n        log_a = asc2.log(a)\n        log_a_p = log_a * p\n        e = asc2.exp(log_a_p)\n        acc = acc + asc2.reduce_sum(e)\n    s = asc2.full([8], acc, dtype=asc.float32)\n    asc2.atomic_add(s, out_gm, [0])\n\n\n@asc2.jit\ndef _k_final_identity(buf_ptr: asc.GlobalAddress, out_ptr: asc.GlobalAddress,\n                      x_ptr: asc.GlobalAddress):\n    buf_gm = asc2.global_tensor(buf_ptr, [8])\n    out_gm = asc2.global_tensor(out_ptr, [8])\n    x_gm = asc2.global_tensor(x_ptr, [8])\n    b = asc2.copy_in(buf_gm, [0], [8], real_shape=[8])\n    x_ref = asc2.copy_in(x_gm, [0], [8], real_shape=[8])\n    asc2.copy_out(b.to(x_ref.dtype), out_gm, [0], real_shape=[8])\n\n\n@asc2.jit\ndef _k_final_sqrt(buf_ptr: asc.GlobalAddress, out_ptr: asc.GlobalAddress,\n                  x_ptr: asc.GlobalAddress):\n    buf_gm = asc2.global_tensor(buf_ptr, [8])\n    out_gm = asc2.global_tensor(out_ptr, [8])\n    x_gm = asc2.global_tensor(x_ptr, [8])\n    b = asc2.copy_in(buf_gm, [0], [8], real_shape=[8])\n    x_ref = asc2.copy_in(x_gm, [0], [8], real_shape=[8])\n    r = asc2.sqrt(b)\n    asc2.copy_out(r.to(x_ref.dtype), out_gm, [0], real_shape=[8])\n\n\n@asc2.jit\ndef _k_final_power(buf_ptr: asc.GlobalAddress, out_ptr: asc.GlobalAddress,\n                   x_ptr: asc.GlobalAddress, p: float):\n    buf_gm = asc2.global_tensor(buf_ptr, [8])\n    out_gm = asc2.global_tensor(out_ptr, [8])\n    x_gm = asc2.global_tensor(x_ptr, [8])\n    b = asc2.copy_in(buf_gm, [0], [8], real_shape=[8])\n    x_ref = asc2.copy_in(x_gm, [0], [8], real_shape=[8])\n    log_s = asc2.log(b)\n    log_s_div_p = log_s / p\n    r = asc2.exp(log_s_div_p)\n    asc2.copy_out(r.to(x_ref.dtype), out_gm, [0], real_shape=[8])\n\n\ndef _launch_norm(x: torch.Tensor, scalar: float):\n    size = x.numel()\n    buf = torch.zeros([8], dtype=torch.float32, device=x.device)\n    out8 = torch.empty(8, dtype=x.dtype, device=x.device)\n\n    if scalar == _INF:\n        tile = _WIDE_TILE\n        num_tiles = asc.ceildiv(size, tile)\n        cores = min(_MAX_CORES, num_tiles) if num_tiles > 0 else 1\n        _k_max_abs[cores](x, buf, size, num_tiles, tile)\n        _k_final_identity[1](buf, out8, x)\n    elif scalar == 1.0:\n        tile = _WIDE_TILE\n        num_tiles = asc.ceildiv(size, tile)\n        cores = min(_MAX_CORES, num_tiles) if num_tiles > 0 else 1\n        _k_sum_abs[cores](x, buf, size, num_tiles, tile)\n        _k_final_identity[1](buf, out8, x)\n    elif scalar == 2.0:\n        tile = _WIDE_TILE\n        num_tiles = asc.ceildiv(size, tile)\n        cores = min(_MAX_CORES, num_tiles) if num_tiles > 0 else 1\n        _k_sum_sq[cores](x, buf, size, num_tiles, tile)\n        _k_final_sqrt[1](buf, out8, x)\n    else:\n        tile = _NARROW_TILE\n        num_tiles = asc.ceildiv(size, tile)\n        cores = min(_MAX_CORES, num_tiles) if num_tiles > 0 else 1\n        _k_sum_gen[cores](x, buf, size, num_tiles, scalar, tile)\n        _k_final_power[1](buf, out8, x, scalar)\n\n    return out8.narrow(0, 0, 1).reshape(())\n\n\ndef foreach_norm(x: list, scalar: float) -> list:\n    ensure_npu_platform()\n    results = []\n    for t in x:\n        tc = t.contiguous() if not t.is_contiguous() else t\n        result = _launch_norm(tc, scalar)\n        results.append(result)\n    return results","lineStart":1,"lineEnd":179,"totalLines":179,"truncated":false}},"title":"integrations/cannbench/workers/.scratch/staged_20260902_155449_foreach_norm/candidate.py","time":{"start":1788353700956,"end":1788353700965}},"id":"prt_0622fe1f8001WLaY5ChFaZgIB1","sessionID":"ses_f9dd033c6ffebNyiS1Y7sf51fp","messageID":"msg_0622fcd07001LZ1K45Jbj9vvoL"}}
