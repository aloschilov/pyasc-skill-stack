{"type":"tool_use","timestamp":1788346918151,"sessionID":"ses_f9e3e4f77ffe3RKgjXodet5Gy6","part":{"type":"tool","tool":"read","callID":"call_e9a682fbc37a4f3ba305bf5b","state":{"status":"completed","input":{"filePath":"/home/aloschilov/workspace/pyasc-skill-stack/integrations/cannbench/pyasc-v2-source/python/asc2/language/range.py"},"output":"<path>/home/aloschilov/workspace/pyasc-skill-stack/integrations/cannbench/pyasc-v2-source/python/asc2/language/range.py</path>\n<type>file</type>\n<content>\n1: # Copyright (c) 2026 Huawei Technologies Co., Ltd.\n2: # This program is free software, you can redistribute it and/or modify it under the terms and conditions of\n3: # CANN Open Software License Agreement Version 2.0 (the \"License\").\n4: # Please refer to the License for details. You may not use this file except in compliance with the License.\n5: # THIS SOFTWARE IS PROVIDED ON AN \"AS IS\" BASIS, WITHOUT WARRANTIES OF ANY KIND, EITHER EXPRESS OR IMPLIED,\n6: # INCLUDING BUT NOT LIMITED TO NON-INFRINGEMENT, MERCHANTABILITY, OR FITNESS FOR A PARTICULAR PURPOSE.\n7: # See LICENSE in the root of the software repository for the full text of the License.\n8: \n9: from typing import overload\n10: \n11: from asc._C import ir\n12: from asc.language.core.range import BaseRange, static_range as asc_static_range\n13: from asc.language.core.utils import global_builder\n14: \n15: from .validation import check_type\n16: \n17: \n18: class range(BaseRange):\n19:     \"\"\"\n20:     A range loop construct for use in JIT functions.\n21: \n22:     This class provides a range-based loop similar to Python's built-in ``range``, with additional support for loop\n23:     unrolling and memory barrier control on NPU.\n24: \n25:     In fact, built-in ``range`` automatically becomes ``asc2.range`` when used inside JIT function.\n26: \n27:     Args:\n28:         start: Start index of the loop (or stop index if only one argument provided).\n29:         stop: Stop index of the loop (exclusive). If None, start is treated as stop and start is 0.\n30:         step: Step size for the loop iteration.\n31:         unroll_factor: Number of iterations to unroll. Default is 1 (no unrolling).\n32:         gm_barrier: Whether to prevent parallel load/store optimization across iterations. Default is False.\n33:             When True, a global memory barrier is inserted between iterations to prevent overlapping memory\n34:             operations. Must be True if loop iterations depend on previous iterations' memory writes.\n35: \n36:     Raises:\n37:         ValueError: If ``unroll_factor`` is less than 1\n38: \n39:     Note:\n40:         The ``unroll_factor`` parameter controls loop unrolling during compilation.\n41:         Higher values can improve performance but increase code size.\n42: \n43:     Examples:\n44:         Basic loop from 0 to N: ::\n45: \n46:             for i in asc2.range(N):\n47:                 ...\n48: \n49:         Loop with unrolling: ::\n50: \n51:             for i in asc2.range(0, N, 1, unroll_factor=4):\n52:                 ...\n53: \n54:         Loop with a global memory barrier (prevent parallel memory optimizations): ::\n55: \n56:             for i in asc2.range(N, gm_barrier=True):\n57:                 ...\n58:     \"\"\"\n59: \n60:     @overload\n61:     def __init__(self, stop: int, /, *, unroll_factor: int = 1, gm_barrier: bool = False):\n62:         ...\n63: \n64:     @overload\n65:     def __init__(self, start: int, stop: int, /, *, unroll_factor: int = 1, gm_barrier: bool = False):\n66:         ...\n67: \n68:     @overload\n69:     def __init__(self, start: int, stop: int, step: int, /, *, unroll_factor: int = 1, gm_barrier: bool = False):\n70:         ...\n71: \n72:     def __init__(self, *args, unroll_factor: int = 1, gm_barrier: bool = False):\n73:         check_type(\"unroll_factor\", unroll_factor, int)\n74:         check_type(\"gm_barrier\", gm_barrier, bool)\n75:         if unroll_factor < 1:\n76:             raise ValueError(f\"Loop unroll factor must be 1 or greater, got {unroll_factor}\")\n77:         super().__init__(*args)\n78:         self.unroll_factor = unroll_factor\n79:         self.gm_barrier = gm_barrier\n80: \n81:     def handle_op(self, op: ir.ForOp) -> None:\n82:         builder = global_builder.get_ir_builder()\n83:         op.set_attr(ir.attr.unroll_factor, builder.get_index_attr(self.unroll_factor))\n84:         if self.gm_barrier:\n85:             op.set_attr(ir.attr.gm_barrier, builder.get_unit_attr())\n86: \n87: \n88: class static_range(asc_static_range):\n89:     \"\"\"\n90:     A static range loop construct for use in JIT functions.\n91: \n92:     Unlike :py:class:`range`, this class requires all loop bounds to be compile-time constants (integers), not runtime\n93:     values. This enables more aggressive compile-time optimizations such as complete loop unrolling.\n94: \n95:     Args:\n96:         start: Start index of the loop (or stop index if only one argument provided)\n97:         stop: Stop index of the loop (exclusive). If None, start is treated as stop and start is 0.\n98:         step: Step size for the loop iteration\n99: \n100:     Raises:\n101:         ValueError: If number of arguments is not between 1 and 3\n102: \n103:     Note:\n104:         All arguments must be integer constants, not runtime values.\n105:         Use :py:class:`range` when loop bounds are runtime-dependent.\n106: \n107:     Examples:\n108:         Loop with compile-time constant bounds: ::\n109: \n110:             for i in asc2.static_range(0, 128):\n111:                 ...\n112:     \"\"\"\n\n(End of file - total 112 lines)\n</content>","metadata":{"preview":"# Copyright (c) 2026 Huawei Technologies Co., Ltd.\n# This program is free software, you can redistribute it and/or modify it under the terms and conditions of\n# CANN Open Software License Agreement Version 2.0 (the \"License\").\n# Please refer to the License for details. You may not use this file except in compliance with the License.\n# THIS SOFTWARE IS PROVIDED ON AN \"AS IS\" BASIS, WITHOUT WARRANTIES OF ANY KIND, EITHER EXPRESS OR IMPLIED,\n# INCLUDING BUT NOT LIMITED TO NON-INFRINGEMENT, MERCHANTABILITY, OR FITNESS FOR A PARTICULAR PURPOSE.\n# See LICENSE in the root of the software repository for the full text of the License.\n\nfrom typing import overload\n\nfrom asc._C import ir\nfrom asc.language.core.range import BaseRange, static_range as asc_static_range\nfrom asc.language.core.utils import global_builder\n\nfrom .validation import check_type\n\n\nclass range(BaseRange):\n    \"\"\"\n    A range loop construct for use in JIT functions.","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/aloschilov/workspace/pyasc-skill-stack/integrations/cannbench/pyasc-v2-source/python/asc2/language/range.py","text":"# Copyright (c) 2026 Huawei Technologies Co., Ltd.\n# This program is free software, you can redistribute it and/or modify it under the terms and conditions of\n# CANN Open Software License Agreement Version 2.0 (the \"License\").\n# Please refer to the License for details. You may not use this file except in compliance with the License.\n# THIS SOFTWARE IS PROVIDED ON AN \"AS IS\" BASIS, WITHOUT WARRANTIES OF ANY KIND, EITHER EXPRESS OR IMPLIED,\n# INCLUDING BUT NOT LIMITED TO NON-INFRINGEMENT, MERCHANTABILITY, OR FITNESS FOR A PARTICULAR PURPOSE.\n# See LICENSE in the root of the software repository for the full text of the License.\n\nfrom typing import overload\n\nfrom asc._C import ir\nfrom asc.language.core.range import BaseRange, static_range as asc_static_range\nfrom asc.language.core.utils import global_builder\n\nfrom .validation import check_type\n\n\nclass range(BaseRange):\n    \"\"\"\n    A range loop construct for use in JIT functions.\n\n    This class provides a range-based loop similar to Python's built-in ``range``, with additional support for loop\n    unrolling and memory barrier control on NPU.\n\n    In fact, built-in ``range`` automatically becomes ``asc2.range`` when used inside JIT function.\n\n    Args:\n        start: Start index of the loop (or stop index if only one argument provided).\n        stop: Stop index of the loop (exclusive). If None, start is treated as stop and start is 0.\n        step: Step size for the loop iteration.\n        unroll_factor: Number of iterations to unroll. Default is 1 (no unrolling).\n        gm_barrier: Whether to prevent parallel load/store optimization across iterations. Default is False.\n            When True, a global memory barrier is inserted between iterations to prevent overlapping memory\n            operations. Must be True if loop iterations depend on previous iterations' memory writes.\n\n    Raises:\n        ValueError: If ``unroll_factor`` is less than 1\n\n    Note:\n        The ``unroll_factor`` parameter controls loop unrolling during compilation.\n        Higher values can improve performance but increase code size.\n\n    Examples:\n        Basic loop from 0 to N: ::\n\n            for i in asc2.range(N):\n                ...\n\n        Loop with unrolling: ::\n\n            for i in asc2.range(0, N, 1, unroll_factor=4):\n                ...\n\n        Loop with a global memory barrier (prevent parallel memory optimizations): ::\n\n            for i in asc2.range(N, gm_barrier=True):\n                ...\n    \"\"\"\n\n    @overload\n    def __init__(self, stop: int, /, *, unroll_factor: int = 1, gm_barrier: bool = False):\n        ...\n\n    @overload\n    def __init__(self, start: int, stop: int, /, *, unroll_factor: int = 1, gm_barrier: bool = False):\n        ...\n\n    @overload\n    def __init__(self, start: int, stop: int, step: int, /, *, unroll_factor: int = 1, gm_barrier: bool = False):\n        ...\n\n    def __init__(self, *args, unroll_factor: int = 1, gm_barrier: bool = False):\n        check_type(\"unroll_factor\", unroll_factor, int)\n        check_type(\"gm_barrier\", gm_barrier, bool)\n        if unroll_factor < 1:\n            raise ValueError(f\"Loop unroll factor must be 1 or greater, got {unroll_factor}\")\n        super().__init__(*args)\n        self.unroll_factor = unroll_factor\n        self.gm_barrier = gm_barrier\n\n    def handle_op(self, op: ir.ForOp) -> None:\n        builder = global_builder.get_ir_builder()\n        op.set_attr(ir.attr.unroll_factor, builder.get_index_attr(self.unroll_factor))\n        if self.gm_barrier:\n            op.set_attr(ir.attr.gm_barrier, builder.get_unit_attr())\n\n\nclass static_range(asc_static_range):\n    \"\"\"\n    A static range loop construct for use in JIT functions.\n\n    Unlike :py:class:`range`, this class requires all loop bounds to be compile-time constants (integers), not runtime\n    values. This enables more aggressive compile-time optimizations such as complete loop unrolling.\n\n    Args:\n        start: Start index of the loop (or stop index if only one argument provided)\n        stop: Stop index of the loop (exclusive). If None, start is treated as stop and start is 0.\n        step: Step size for the loop iteration\n\n    Raises:\n        ValueError: If number of arguments is not between 1 and 3\n\n    Note:\n        All arguments must be integer constants, not runtime values.\n        Use :py:class:`range` when loop bounds are runtime-dependent.\n\n    Examples:\n        Loop with compile-time constant bounds: ::\n\n            for i in asc2.static_range(0, 128):\n                ...\n    \"\"\"","lineStart":1,"lineEnd":112,"totalLines":112,"truncated":false}},"title":"integrations/cannbench/pyasc-v2-source/python/asc2/language/range.py","time":{"start":1788346918144,"end":1788346918149}},"id":"prt_061c86491001UOXoB50MRWBwXH","sessionID":"ses_f9e3e4f77ffe3RKgjXodet5Gy6","messageID":"msg_061c84810001AIniwBhHDrigjn"}}
