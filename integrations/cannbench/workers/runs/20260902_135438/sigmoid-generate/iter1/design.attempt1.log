{"type":"tool_use","timestamp":1788346868546,"sessionID":"ses_f9e3e4f77ffe3RKgjXodet5Gy6","part":{"type":"tool","tool":"read","callID":"call_b71dbc7c34264d0d93cd5743","state":{"status":"completed","input":{"filePath":"/home/aloschilov/workspace/pyasc-skill-stack/integrations/cannbench/submission/cann_bench/_pyasc_runtime.py"},"output":"<path>/home/aloschilov/workspace/pyasc-skill-stack/integrations/cannbench/submission/cann_bench/_pyasc_runtime.py</path>\n<type>file</type>\n<content>\n1: \"\"\"One-time pyasc NPU platform initialisation shared by all operator modules.\n2: \n3: The cann-bench harness imports ``cann_bench`` inside a torch_npu process and\n4: calls the operator wrappers with NPU-resident tensors. pyasc must be switched\n5: to its NPU backend once, before the first kernel launch. The platform can be\n6: overridden with ``CANN_BENCH_PYASC_PLATFORM`` (SoC version string).\n7: \"\"\"\n8: \n9: import os\n10: import threading\n11: \n12: _lock = threading.Lock()\n13: _initialised = False\n14: \n15: \n16: def ensure_npu_platform() -> None:\n17:     \"\"\"Switch pyasc to the NPU backend exactly once (thread-safe).\"\"\"\n18:     global _initialised\n19:     if _initialised:\n20:         return\n21:     with _lock:\n22:         if _initialised:\n23:             return\n24:         import asc.runtime.config as config\n25: \n26:         override = os.environ.get(\"CANN_BENCH_PYASC_PLATFORM\")\n27:         if override:\n28:             try:\n29:                 platform = config.Platform(override)\n30:             except ValueError as exc:\n31:                 raise RuntimeError(\n32:                     f\"unsupported pyasc platform override {override!r}; \"\n33:                     f\"available: {[p.value for p in config.Platform]}\"\n34:                 ) from exc\n35:             config.set_platform(config.Backend.NPU, platform)\n36:         else:\n37:             # CANNBench's 950PR runner pool contains multiple SoC revisions\n38:             # (for example 957c and 9599). Let pyasc query the active device so\n39:             # the submitted wheel remains portable across those runners.\n40:             config.set_platform(config.Backend.NPU)\n41:         _initialised = True\n\n(End of file - total 41 lines)\n</content>","metadata":{"preview":"\"\"\"One-time pyasc NPU platform initialisation shared by all operator modules.\n\nThe cann-bench harness imports ``cann_bench`` inside a torch_npu process and\ncalls the operator wrappers with NPU-resident tensors. pyasc must be switched\nto its NPU backend once, before the first kernel launch. The platform can be\noverridden with ``CANN_BENCH_PYASC_PLATFORM`` (SoC version string).\n\"\"\"\n\nimport os\nimport threading\n\n_lock = threading.Lock()\n_initialised = False\n\n\ndef ensure_npu_platform() -> None:\n    \"\"\"Switch pyasc to the NPU backend exactly once (thread-safe).\"\"\"\n    global _initialised\n    if _initialised:\n        return","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/aloschilov/workspace/pyasc-skill-stack/integrations/cannbench/submission/cann_bench/_pyasc_runtime.py","text":"\"\"\"One-time pyasc NPU platform initialisation shared by all operator modules.\n\nThe cann-bench harness imports ``cann_bench`` inside a torch_npu process and\ncalls the operator wrappers with NPU-resident tensors. pyasc must be switched\nto its NPU backend once, before the first kernel launch. The platform can be\noverridden with ``CANN_BENCH_PYASC_PLATFORM`` (SoC version string).\n\"\"\"\n\nimport os\nimport threading\n\n_lock = threading.Lock()\n_initialised = False\n\n\ndef ensure_npu_platform() -> None:\n    \"\"\"Switch pyasc to the NPU backend exactly once (thread-safe).\"\"\"\n    global _initialised\n    if _initialised:\n        return\n    with _lock:\n        if _initialised:\n            return\n        import asc.runtime.config as config\n\n        override = os.environ.get(\"CANN_BENCH_PYASC_PLATFORM\")\n        if override:\n            try:\n                platform = config.Platform(override)\n            except ValueError as exc:\n                raise RuntimeError(\n                    f\"unsupported pyasc platform override {override!r}; \"\n                    f\"available: {[p.value for p in config.Platform]}\"\n                ) from exc\n            config.set_platform(config.Backend.NPU, platform)\n        else:\n            # CANNBench's 950PR runner pool contains multiple SoC revisions\n            # (for example 957c and 9599). Let pyasc query the active device so\n            # the submitted wheel remains portable across those runners.\n            config.set_platform(config.Backend.NPU)\n        _initialised = True","lineStart":1,"lineEnd":41,"totalLines":41,"truncated":false}},"title":"integrations/cannbench/submission/cann_bench/_pyasc_runtime.py","time":{"start":1788346868539,"end":1788346868545}},"id":"prt_061c7a218001dPJAp94bF1uM8g","sessionID":"ses_f9e3e4f77ffe3RKgjXodet5Gy6","messageID":"msg_061c77d22001L8pjWXaFPc7xWP"}}
