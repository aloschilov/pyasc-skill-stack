{"type":"tool_use","timestamp":1788342249764,"sessionID":"ses_f9e8d1600ffeTOnADKxO6TVRTr","part":{"type":"tool","tool":"read","callID":"call_8c13c1c2e512453b8fb9a4ab","state":{"status":"completed","input":{"filePath":"/home/aloschilov/workspace/pyasc-skill-stack/golden/kernels/rms_norm_f16.py","offset":85,"limit":75},"output":"<path>/home/aloschilov/workspace/pyasc-skill-stack/golden/kernels/rms_norm_f16.py</path>\n<type>file</type>\n<content>\n85: UB_BUDGET_BYTES = 64 * 1024\n86: \n87: logging.basicConfig(level=logging.INFO)\n88: \n89: \n90: @asc2.jit(reuse_alloc=1)\n91: def rms_norm_full_row_kernel(x_ptr: asc2.GlobalAddress, gamma_ptr: asc2.GlobalAddress,\n92:                              out_ptr: asc2.GlobalAddress,\n93:                              num_rows: int,\n94:                              num_cols: asc2.ConstExpr,\n95:                              epsilon: asc.ConstExpr[float]):\n96:     \"\"\"Full-row variant for float16. Mirrors CANN's\n97:     ``KernelRmsNormRegBase``; accumulator stays in float32.\n98:     \"\"\"\n99:     x_gm = asc2.global_tensor(x_ptr, [num_rows, num_cols])\n100:     gamma_gm_2d = asc2.global_tensor(gamma_ptr, [1, num_cols])\n101:     out_gm = asc2.global_tensor(out_ptr, [num_rows, num_cols])\n102: \n103:     for row in asc2.range(asc2.block_idx(), num_rows, asc2.block_num(),\n104:                           unroll_factor=2):\n105:         x_row = asc2.copy_in(x_gm, [row, 0], [1, num_cols])\n106:         x_row_f32 = x_row.to(asc.float32)\n107:         sum_sq = asc2.reduce_sum(x_row_f32 * x_row_f32)\n108:         inv_rms = 1.0 / asc2.sqrt(sum_sq / num_cols + epsilon)\n109: \n110:         gamma_row = asc2.copy_in(gamma_gm_2d, [0, 0], [1, num_cols])\n111:         gamma_row_f32 = gamma_row.to(asc.float32)\n112:         out_f32 = x_row_f32 * gamma_row_f32 * inv_rms\n113:         asc2.copy_out(out_f32.to(x_row.dtype), out_gm, [row, 0])\n114: \n115: \n116: @asc2.jit(reuse_alloc=1)\n117: def rms_norm_split_d_kernel(x_ptr: asc2.GlobalAddress, gamma_ptr: asc2.GlobalAddress,\n118:                             out_ptr: asc2.GlobalAddress,\n119:                             num_rows: int, num_cols: int, padded_cols: int,\n120:                             num_tiles: int,\n121:                             tile_cols: asc2.ConstExpr,\n122:                             epsilon: asc.ConstExpr[float]):\n123:     \"\"\"Split-D variant for float16. Mirrors CANN's\n124:     ``KernelRmsNormRegBaseSplitD``; accumulator stays in float32; output\n125:     is cast back to ``x.dtype`` before storing.\n126:     \"\"\"\n127:     x_gm = asc2.global_tensor(x_ptr, [num_rows, padded_cols])\n128:     gamma_gm_2d = asc2.global_tensor(gamma_ptr, [1, padded_cols])\n129:     out_gm = asc2.global_tensor(out_ptr, [num_rows, padded_cols])\n130: \n131:     for row in asc2.range(asc2.block_idx(), num_rows, asc2.block_num(),\n132:                           unroll_factor=2):\n133:         zero_seed = asc2.full([1, tile_cols], 0.0, dtype=asc.float32)\n134:         sum_sq = asc2.reduce_sum(zero_seed)\n135: \n136:         # Inner reduction loop carries `sum_sq` across iterations -> NOT parallel.\n137:         for tile_id in asc2.range(num_tiles, unroll_factor=2):\n138:             col = tile_id * tile_cols\n139:             x = asc2.copy_in(x_gm, [row, col], [1, tile_cols])\n140:             x_f32 = x.to(asc.float32)\n141:             sum_sq = sum_sq + asc2.reduce_sum(x_f32 * x_f32)\n142: \n143:         inv_rms = 1.0 / asc2.sqrt(sum_sq / num_cols + epsilon)\n144: \n145:         # Disjoint write-back -> safe to parallelise.\n146:         for tile_id in asc2.range(num_tiles, unroll_factor=2):\n147:             col = tile_id * tile_cols\n148:             x = asc2.copy_in(x_gm, [row, col], [1, tile_cols])\n149:             gamma = asc2.copy_in(gamma_gm_2d, [0, col], [1, tile_cols])\n150:             x_f32 = x.to(asc.float32)\n151:             gamma_f32 = gamma.to(asc.float32)\n152:             out_f32 = x_f32 * gamma_f32 * inv_rms\n153:             asc2.copy_out(out_f32.to(x.dtype), out_gm, [row, col])\n154: \n155: \n156: def _full_row_launch(x: torch.Tensor, gamma: torch.Tensor, eps: float,\n157:                      core_num: int) -> torch.Tensor:\n158:     num_rows, num_cols = x.shape\n159:     out = torch.empty_like(x)\n\n(Showing lines 85-159 of 249. Use offset=160 to continue.)\n</content>","metadata":{"preview":"UB_BUDGET_BYTES = 64 * 1024\n\nlogging.basicConfig(level=logging.INFO)\n\n\n@asc2.jit(reuse_alloc=1)\ndef rms_norm_full_row_kernel(x_ptr: asc2.GlobalAddress, gamma_ptr: asc2.GlobalAddress,\n                             out_ptr: asc2.GlobalAddress,\n                             num_rows: int,\n                             num_cols: asc2.ConstExpr,\n                             epsilon: asc.ConstExpr[float]):\n    \"\"\"Full-row variant for float16. Mirrors CANN's\n    ``KernelRmsNormRegBase``; accumulator stays in float32.\n    \"\"\"\n    x_gm = asc2.global_tensor(x_ptr, [num_rows, num_cols])\n    gamma_gm_2d = asc2.global_tensor(gamma_ptr, [1, num_cols])\n    out_gm = asc2.global_tensor(out_ptr, [num_rows, num_cols])\n\n    for row in asc2.range(asc2.block_idx(), num_rows, asc2.block_num(),\n                          unroll_factor=2):","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/aloschilov/workspace/pyasc-skill-stack/golden/kernels/rms_norm_f16.py","text":"UB_BUDGET_BYTES = 64 * 1024\n\nlogging.basicConfig(level=logging.INFO)\n\n\n@asc2.jit(reuse_alloc=1)\ndef rms_norm_full_row_kernel(x_ptr: asc2.GlobalAddress, gamma_ptr: asc2.GlobalAddress,\n                             out_ptr: asc2.GlobalAddress,\n                             num_rows: int,\n                             num_cols: asc2.ConstExpr,\n                             epsilon: asc.ConstExpr[float]):\n    \"\"\"Full-row variant for float16. Mirrors CANN's\n    ``KernelRmsNormRegBase``; accumulator stays in float32.\n    \"\"\"\n    x_gm = asc2.global_tensor(x_ptr, [num_rows, num_cols])\n    gamma_gm_2d = asc2.global_tensor(gamma_ptr, [1, num_cols])\n    out_gm = asc2.global_tensor(out_ptr, [num_rows, num_cols])\n\n    for row in asc2.range(asc2.block_idx(), num_rows, asc2.block_num(),\n                          unroll_factor=2):\n        x_row = asc2.copy_in(x_gm, [row, 0], [1, num_cols])\n        x_row_f32 = x_row.to(asc.float32)\n        sum_sq = asc2.reduce_sum(x_row_f32 * x_row_f32)\n        inv_rms = 1.0 / asc2.sqrt(sum_sq / num_cols + epsilon)\n\n        gamma_row = asc2.copy_in(gamma_gm_2d, [0, 0], [1, num_cols])\n        gamma_row_f32 = gamma_row.to(asc.float32)\n        out_f32 = x_row_f32 * gamma_row_f32 * inv_rms\n        asc2.copy_out(out_f32.to(x_row.dtype), out_gm, [row, 0])\n\n\n@asc2.jit(reuse_alloc=1)\ndef rms_norm_split_d_kernel(x_ptr: asc2.GlobalAddress, gamma_ptr: asc2.GlobalAddress,\n                            out_ptr: asc2.GlobalAddress,\n                            num_rows: int, num_cols: int, padded_cols: int,\n                            num_tiles: int,\n                            tile_cols: asc2.ConstExpr,\n                            epsilon: asc.ConstExpr[float]):\n    \"\"\"Split-D variant for float16. Mirrors CANN's\n    ``KernelRmsNormRegBaseSplitD``; accumulator stays in float32; output\n    is cast back to ``x.dtype`` before storing.\n    \"\"\"\n    x_gm = asc2.global_tensor(x_ptr, [num_rows, padded_cols])\n    gamma_gm_2d = asc2.global_tensor(gamma_ptr, [1, padded_cols])\n    out_gm = asc2.global_tensor(out_ptr, [num_rows, padded_cols])\n\n    for row in asc2.range(asc2.block_idx(), num_rows, asc2.block_num(),\n                          unroll_factor=2):\n        zero_seed = asc2.full([1, tile_cols], 0.0, dtype=asc.float32)\n        sum_sq = asc2.reduce_sum(zero_seed)\n\n        # Inner reduction loop carries `sum_sq` across iterations -> NOT parallel.\n        for tile_id in asc2.range(num_tiles, unroll_factor=2):\n            col = tile_id * tile_cols\n            x = asc2.copy_in(x_gm, [row, col], [1, tile_cols])\n            x_f32 = x.to(asc.float32)\n            sum_sq = sum_sq + asc2.reduce_sum(x_f32 * x_f32)\n\n        inv_rms = 1.0 / asc2.sqrt(sum_sq / num_cols + epsilon)\n\n        # Disjoint write-back -> safe to parallelise.\n        for tile_id in asc2.range(num_tiles, unroll_factor=2):\n            col = tile_id * tile_cols\n            x = asc2.copy_in(x_gm, [row, col], [1, tile_cols])\n            gamma = asc2.copy_in(gamma_gm_2d, [0, col], [1, tile_cols])\n            x_f32 = x.to(asc.float32)\n            gamma_f32 = gamma.to(asc.float32)\n            out_f32 = x_f32 * gamma_f32 * inv_rms\n            asc2.copy_out(out_f32.to(x.dtype), out_gm, [row, col])\n\n\ndef _full_row_launch(x: torch.Tensor, gamma: torch.Tensor, eps: float,\n                     core_num: int) -> torch.Tensor:\n    num_rows, num_cols = x.shape\n    out = torch.empty_like(x)","lineStart":85,"lineEnd":159,"totalLines":249,"truncated":true}},"title":"golden/kernels/rms_norm_f16.py","time":{"start":1788342249745,"end":1788342249762}},"id":"prt_0618127210019t703dL3Hr6hD5","sessionID":"ses_f9e8d1600ffeTOnADKxO6TVRTr","messageID":"msg_0617aa3a7001uzhqUEJ3IzfHez"}}
