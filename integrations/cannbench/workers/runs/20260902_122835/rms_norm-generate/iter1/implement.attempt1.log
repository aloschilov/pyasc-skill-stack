{"type":"tool_use","timestamp":1788342864934,"sessionID":"ses_f9e7ce64cffeAsGz5NPyXDv1o3","part":{"type":"tool","tool":"read","callID":"call_ec96c6eb0bf648a7bbbf0d24","state":{"status":"completed","input":{"filePath":"/home/aloschilov/workspace/pyasc-skill-stack/integrations/cannbench/workers/.scratch/20260902_122835/rms_norm-generate/candidate.py"},"output":"<path>/home/aloschilov/workspace/pyasc-skill-stack/integrations/cannbench/workers/.scratch/20260902_122835/rms_norm-generate/candidate.py</path>\n<type>file</type>\n<content>\n1: \"\"\"CANN Bench RmsNorm interface implemented as a pyasc asc2 kernel.\n2: \n3: Kernel design (proven full-row / split-D two-kernel pattern):\n4:   - Flatten x to (rows, cols) where cols = last dim D. Each row is\n5:     normalized independently along the last dimension.\n6:   - Full-row kernel: when D <= 2048 and D is 32-byte aligned, the whole\n7:     row fits in UB -- single-pass load-reduce-scale-store per row.\n8:   - Split-D kernel: otherwise, stream D in aligned tile chunks with a\n9:     two-pass reduce-then-write per row (loop-carried f32 accumulator).\n10:   - f16/bf16 inputs are promoted to f32 inside the kernel before\n11:     squaring (prevents f16 x^2 overflow on boundary values like +-65504).\n12:   - Rows are distributed grid-stride across up to 72 AIV cores.\n13:   - Tail tiles handled with real_shape (no host zero-padding); zero\n14:     padding does not bias the reduction since the mean divides by real D.\n15:   - epsilon is a runtime float argument (no per-epsilon recompilation).\n16: \"\"\"\n17: \n18: import torch\n19: \n20: import asc\n21: import asc2\n22: \n23: from ._pyasc_runtime import ensure_npu_platform\n24: \n25: _MAX_CORES = 72\n26: _FULL_ROW_LIMIT = 2048\n27: _SMALL_D_LIMIT = 256\n28: _TILE_LARGE = 2048\n29: _TILE_SMALL = 64\n30: \n31: \n32: @asc2.jit\n33: def _rms_norm_full_row_kernel(x_ptr: asc.GlobalAddress,\n34:                              gamma_ptr: asc.GlobalAddress,\n35:                              out_ptr: asc.GlobalAddress,\n36:                              rows: int,\n37:                              cols: asc.ConstExpr[int],\n38:                              epsilon: float):\n39:     x_gm = asc2.global_tensor(x_ptr, [rows, cols])\n40:     gamma_gm = asc2.global_tensor(gamma_ptr, [1, cols])\n41:     out_gm = asc2.global_tensor(out_ptr, [rows, cols])\n42:     for row in asc2.range(asc2.block_idx(), rows, asc2.block_num(),\n43:                           unroll_factor=2):\n44:         x_row = asc2.copy_in(x_gm, [row, 0], [1, cols])\n45:         xf = x_row.to(asc.float32)\n46:         sum_sq = asc2.reduce_sum(xf * xf)\n47:         inv_rms = 1.0 / asc2.sqrt(sum_sq / cols + epsilon)\n48:         gamma_row = asc2.copy_in(gamma_gm, [0, 0], [1, cols])\n49:         gf = gamma_row.to(asc.float32)\n50:         y = xf * gf * inv_rms\n51:         asc2.copy_out(y.to(x_row.dtype), out_gm, [row, 0])\n52: \n53: \n54: @asc2.jit\n55: def _rms_norm_split_d_kernel(x_ptr: asc.GlobalAddress,\n56:                              gamma_ptr: asc.GlobalAddress,\n57:                              out_ptr: asc.GlobalAddress,\n58:                              rows: int,\n59:                              cols: int,\n60:                              num_tiles: int,\n61:                              tile_size: asc.ConstExpr[int],\n62:                              epsilon: float):\n63:     x_gm = asc2.global_tensor(x_ptr, [rows, cols])\n64:     gamma_gm = asc2.global_tensor(gamma_ptr, [1, cols])\n65:     out_gm = asc2.global_tensor(out_ptr, [rows, cols])\n66:     for row in asc2.range(asc2.block_idx(), rows, asc2.block_num(),\n67:                           unroll_factor=2):\n68:         zero_seed = asc2.full([1, tile_size], 0.0, dtype=asc.float32)\n69:         acc = asc2.reduce_sum(zero_seed)\n70:         for tile_id in asc2.range(num_tiles, unroll_factor=2):\n71:             col = tile_id * tile_size\n72:             n = tile_size if col + tile_size <= cols else cols - col\n73:             x = asc2.copy_in(x_gm, [row, col], [1, tile_size],\n74:                              real_shape=[1, n])\n75:             xf = x.to(asc.float32)\n76:             acc = acc + asc2.reduce_sum(xf * xf)\n77:         inv_rms = 1.0 / asc2.sqrt(acc / cols + epsilon)\n78:         for tile_id in asc2.range(num_tiles, unroll_factor=2):\n79:             col = tile_id * tile_size\n80:             n = tile_size if col + tile_size <= cols else cols - col\n81:             x = asc2.copy_in(x_gm, [row, col], [1, tile_size],\n82:                              real_shape=[1, n])\n83:             gamma = asc2.copy_in(gamma_gm, [0, col], [1, tile_size],\n84:                                  real_shape=[1, n])\n85:             y = x.to(asc.float32) * gamma.to(asc.float32) * inv_rms\n86:             asc2.copy_out(y.to(x.dtype), out_gm, [row, col],\n87:                           real_shape=[1, n])\n88: \n89: \n90: def rms_norm(x: torch.Tensor, gamma: torch.Tensor,\n91:              epsilon: float = 1e-6) -> torch.Tensor:\n92:     \"\"\"RMS normalization along the last dimension via pyasc asc2 kernels.\n93: \n94:     Args:\n95:         x: input tensor of shape (..., D); D is the normalization dim.\n96:         gamma: scaling parameter of shape (D,), same dtype as x.\n97:         epsilon: numerical stability constant (default 1e-6).\n98: \n99:     Returns:\n100:         RMS-normalized tensor with the same shape and dtype as x.\n101:     \"\"\"\n102:     ensure_npu_platform()\n103:     if not x.is_contiguous():\n104:         x = x.contiguous()\n105:     if not gamma.is_contiguous():\n106:         gamma = gamma.contiguous()\n107:     out = torch.empty_like(x)\n108:     total = x.numel()\n109:     if total == 0:\n110:         return out\n111:     cols = x.shape[-1]\n112:     rows = total // cols\n113:     cores = min(_MAX_CORES, rows)\n114:     if x.dtype == torch.float32:\n115:         align = 8\n116:     else:\n117:         align = 16\n118:     eps = float(epsilon)\n119:     if cols <= _FULL_ROW_LIMIT and cols % align == 0:\n120:         _rms_norm_full_row_kernel[cores](x, gamma, out, rows, cols, eps)\n121:     elif cols <= _SMALL_D_LIMIT:\n122:         num_tiles = asc.ceildiv(cols, _TILE_SMALL)\n123:         _rms_norm_split_d_kernel[cores](x, gamma, out, rows, cols,\n124:                                         num_tiles, _TILE_SMALL, eps)\n125:     else:\n126:         num_tiles = asc.ceildiv(cols, _TILE_LARGE)\n127:         _rms_norm_split_d_kernel[cores](x, gamma, out, rows, cols,\n128:                                         num_tiles, _TILE_LARGE, eps)\n129:     return out\n\n(End of file - total 129 lines)\n</content>","metadata":{"preview":"\"\"\"CANN Bench RmsNorm interface implemented as a pyasc asc2 kernel.\n\nKernel design (proven full-row / split-D two-kernel pattern):\n  - Flatten x to (rows, cols) where cols = last dim D. Each row is\n    normalized independently along the last dimension.\n  - Full-row kernel: when D <= 2048 and D is 32-byte aligned, the whole\n    row fits in UB -- single-pass load-reduce-scale-store per row.\n  - Split-D kernel: otherwise, stream D in aligned tile chunks with a\n    two-pass reduce-then-write per row (loop-carried f32 accumulator).\n  - f16/bf16 inputs are promoted to f32 inside the kernel before\n    squaring (prevents f16 x^2 overflow on boundary values like +-65504).\n  - Rows are distributed grid-stride across up to 72 AIV cores.\n  - Tail tiles handled with real_shape (no host zero-padding); zero\n    padding does not bias the reduction since the mean divides by real D.\n  - epsilon is a runtime float argument (no per-epsilon recompilation).\n\"\"\"\n\nimport torch\n\nimport asc","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/aloschilov/workspace/pyasc-skill-stack/integrations/cannbench/workers/.scratch/20260902_122835/rms_norm-generate/candidate.py","text":"\"\"\"CANN Bench RmsNorm interface implemented as a pyasc asc2 kernel.\n\nKernel design (proven full-row / split-D two-kernel pattern):\n  - Flatten x to (rows, cols) where cols = last dim D. Each row is\n    normalized independently along the last dimension.\n  - Full-row kernel: when D <= 2048 and D is 32-byte aligned, the whole\n    row fits in UB -- single-pass load-reduce-scale-store per row.\n  - Split-D kernel: otherwise, stream D in aligned tile chunks with a\n    two-pass reduce-then-write per row (loop-carried f32 accumulator).\n  - f16/bf16 inputs are promoted to f32 inside the kernel before\n    squaring (prevents f16 x^2 overflow on boundary values like +-65504).\n  - Rows are distributed grid-stride across up to 72 AIV cores.\n  - Tail tiles handled with real_shape (no host zero-padding); zero\n    padding does not bias the reduction since the mean divides by real D.\n  - epsilon is a runtime float argument (no per-epsilon recompilation).\n\"\"\"\n\nimport torch\n\nimport asc\nimport asc2\n\nfrom ._pyasc_runtime import ensure_npu_platform\n\n_MAX_CORES = 72\n_FULL_ROW_LIMIT = 2048\n_SMALL_D_LIMIT = 256\n_TILE_LARGE = 2048\n_TILE_SMALL = 64\n\n\n@asc2.jit\ndef _rms_norm_full_row_kernel(x_ptr: asc.GlobalAddress,\n                             gamma_ptr: asc.GlobalAddress,\n                             out_ptr: asc.GlobalAddress,\n                             rows: int,\n                             cols: asc.ConstExpr[int],\n                             epsilon: float):\n    x_gm = asc2.global_tensor(x_ptr, [rows, cols])\n    gamma_gm = asc2.global_tensor(gamma_ptr, [1, cols])\n    out_gm = asc2.global_tensor(out_ptr, [rows, cols])\n    for row in asc2.range(asc2.block_idx(), rows, asc2.block_num(),\n                          unroll_factor=2):\n        x_row = asc2.copy_in(x_gm, [row, 0], [1, cols])\n        xf = x_row.to(asc.float32)\n        sum_sq = asc2.reduce_sum(xf * xf)\n        inv_rms = 1.0 / asc2.sqrt(sum_sq / cols + epsilon)\n        gamma_row = asc2.copy_in(gamma_gm, [0, 0], [1, cols])\n        gf = gamma_row.to(asc.float32)\n        y = xf * gf * inv_rms\n        asc2.copy_out(y.to(x_row.dtype), out_gm, [row, 0])\n\n\n@asc2.jit\ndef _rms_norm_split_d_kernel(x_ptr: asc.GlobalAddress,\n                             gamma_ptr: asc.GlobalAddress,\n                             out_ptr: asc.GlobalAddress,\n                             rows: int,\n                             cols: int,\n                             num_tiles: int,\n                             tile_size: asc.ConstExpr[int],\n                             epsilon: float):\n    x_gm = asc2.global_tensor(x_ptr, [rows, cols])\n    gamma_gm = asc2.global_tensor(gamma_ptr, [1, cols])\n    out_gm = asc2.global_tensor(out_ptr, [rows, cols])\n    for row in asc2.range(asc2.block_idx(), rows, asc2.block_num(),\n                          unroll_factor=2):\n        zero_seed = asc2.full([1, tile_size], 0.0, dtype=asc.float32)\n        acc = asc2.reduce_sum(zero_seed)\n        for tile_id in asc2.range(num_tiles, unroll_factor=2):\n            col = tile_id * tile_size\n            n = tile_size if col + tile_size <= cols else cols - col\n            x = asc2.copy_in(x_gm, [row, col], [1, tile_size],\n                             real_shape=[1, n])\n            xf = x.to(asc.float32)\n            acc = acc + asc2.reduce_sum(xf * xf)\n        inv_rms = 1.0 / asc2.sqrt(acc / cols + epsilon)\n        for tile_id in asc2.range(num_tiles, unroll_factor=2):\n            col = tile_id * tile_size\n            n = tile_size if col + tile_size <= cols else cols - col\n            x = asc2.copy_in(x_gm, [row, col], [1, tile_size],\n                             real_shape=[1, n])\n            gamma = asc2.copy_in(gamma_gm, [0, col], [1, tile_size],\n                                 real_shape=[1, n])\n            y = x.to(asc.float32) * gamma.to(asc.float32) * inv_rms\n            asc2.copy_out(y.to(x.dtype), out_gm, [row, col],\n                          real_shape=[1, n])\n\n\ndef rms_norm(x: torch.Tensor, gamma: torch.Tensor,\n             epsilon: float = 1e-6) -> torch.Tensor:\n    \"\"\"RMS normalization along the last dimension via pyasc asc2 kernels.\n\n    Args:\n        x: input tensor of shape (..., D); D is the normalization dim.\n        gamma: scaling parameter of shape (D,), same dtype as x.\n        epsilon: numerical stability constant (default 1e-6).\n\n    Returns:\n        RMS-normalized tensor with the same shape and dtype as x.\n    \"\"\"\n    ensure_npu_platform()\n    if not x.is_contiguous():\n        x = x.contiguous()\n    if not gamma.is_contiguous():\n        gamma = gamma.contiguous()\n    out = torch.empty_like(x)\n    total = x.numel()\n    if total == 0:\n        return out\n    cols = x.shape[-1]\n    rows = total // cols\n    cores = min(_MAX_CORES, rows)\n    if x.dtype == torch.float32:\n        align = 8\n    else:\n        align = 16\n    eps = float(epsilon)\n    if cols <= _FULL_ROW_LIMIT and cols % align == 0:\n        _rms_norm_full_row_kernel[cores](x, gamma, out, rows, cols, eps)\n    elif cols <= _SMALL_D_LIMIT:\n        num_tiles = asc.ceildiv(cols, _TILE_SMALL)\n        _rms_norm_split_d_kernel[cores](x, gamma, out, rows, cols,\n                                        num_tiles, _TILE_SMALL, eps)\n    else:\n        num_tiles = asc.ceildiv(cols, _TILE_LARGE)\n        _rms_norm_split_d_kernel[cores](x, gamma, out, rows, cols,\n                                        num_tiles, _TILE_LARGE, eps)\n    return out","lineStart":1,"lineEnd":129,"totalLines":129,"truncated":false}},"title":"integrations/cannbench/workers/.scratch/20260902_122835/rms_norm-generate/candidate.py","time":{"start":1788342864920,"end":1788342864931}},"id":"prt_0618a8a2e001mFC0DdfctIQe30","sessionID":"ses_f9e7ce64cffeAsGz5NPyXDv1o3","messageID":"msg_0618a3274001inxvt0q0Qhfdmx"}}
