# Copy to .env on each runner host (NEVER commit the real .env).
#   cp .env.example .env  &&  edit the credential + AR_BASE
#
# Compose auto-loads ./.env for BOTH variable interpolation (paths below) and as
# the container env_file (runner credential + scope).
#
# --- Registration credential: choose ONE ---
# Durable (recommended): a GitHub PAT; the entrypoint mints a fresh registration
# token on every (re)start, so the runner survives reboots. Set EPHEMERAL=true
# for a fresh runner per job. Required PAT scope: classic `repo`, or fine-grained
# with repo Administration: Read and write (+ Metadata: Read).
#ACCESS_TOKEN=ghp_xxx
#EPHEMERAL=true
#
# Quick bring-up without a PAT: a short-lived (1h) registration token from
#   gh api -X POST repos/<owner>/<repo>/actions/runners/registration-token -q .token
# Persistent runner; re-registration after a reboot needs a fresh token.
#RUNNER_TOKEN=AXXX...

REPO_URL=https://github.com/aloschilov/pyasc-skill-stack

# --- Host path base ---
# DooD path alignment: the runner's work dir is bind-mounted at the IDENTICAL
# host path, because CI's sibling `docker run -v "$PWD":/workspace` mounts are
# resolved by the daemon, not inside the runner. compose.arm64.yml uses
# ${AR_BASE}/work, which must be a real, writable host directory. On a Mac it
# must sit under a Docker-Desktop file-shared root such as /Users/<you>.
#
# Create it before bringing the stack up: mkdir -p "$AR_BASE/work"
#   MacBook:   AR_BASE=/Users/<you>/ar
AR_BASE=/Users/<you>/ar

# compose.arm64.yml defines a single runner, so AR_BASE is the only path it
# needs. If a fan-out workload returns and you re-add runner2/runner3, give
# each a DISTINCT base under the same shared root (AR_BASE2, AR_BASE3) so
# concurrent jobs do not collide in a shared _work dir.
