# Copy to .env on each runner host (NEVER commit the real .env).
#   cp .env.example .env  &&  edit the credential + AR_BASE
#
# Compose auto-loads ./.env for BOTH variable interpolation (paths below) and as
# the container env_file (runner credential + scope).
#
# --- Registration credential: choose ONE ---
# Durable (recommended): a GitHub PAT; the entrypoint mints a fresh registration
# token on every (re)start, so the runner survives reboots. Set EPHEMERAL=true
# for a fresh runner per job. Required PAT scope: classic `repo`, or fine-grained
# with repo Administration: Read and write (+ Metadata: Read).
#ACCESS_TOKEN=ghp_xxx
#EPHEMERAL=true
#
# Quick bring-up without a PAT: a short-lived (1h) registration token from
#   gh api -X POST repos/aloschilov/pyasc-skill-stack/actions/runners/registration-token -q .token
# Persistent runner; re-registration after a reboot needs a fresh token.
#RUNNER_TOKEN=AXXX...

REPO_URL=https://github.com/aloschilov/pyasc-skill-stack

# --- Host path base (DooD path alignment: each runner's work dir is bind-mounted
# at the IDENTICAL host path). compose.gpu.yml uses ${AR_BASE}/work-{1,2,3} +
# ${AR_BASE}/ollama-{1,2,3}; compose.arm64.yml uses ${AR_BASE}/work. AR_BASE must
# be a real, writable host dir (on the Mac it must be under a Docker-Desktop
# file-shared path such as /Users/<you>).
#   4090 box:  AR_BASE=/home/loschilov_aa/ar
#   MacBook:   AR_BASE=/Users/aloschilov/ar
AR_BASE=/home/loschilov_aa/ar
