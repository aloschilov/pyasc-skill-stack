// Standalone SIMT control for two short FP32 geometries on Ascend 950PR.
#include "acl/acl.h"
#include "simt_api/math_functions.h"
#include <cstdlib>
#include <fstream>
#include <iostream>
#include <string>
#include <vector>

template<unsigned Rows, unsigned Half, unsigned Height>
__global__ void short_rows(const float* x, float* y) {
    const unsigned first = blockIdx.x * Height;
    const unsigned count = (Rows - first < Height ? Rows - first : Height) * Half;
    for (unsigned i = threadIdx.x; i < count; i += blockDim.x) {
        const unsigned row = first + i / Half;
        const unsigned src = 2 * row * Half + i % Half;
        const float gate = x[src];
        y[first * Half + i] = (gate / (1.0f + expf(-gate))) * x[src + Half];
    }
}

static void check(aclError rc, const char* op) {
    if (rc != ACL_SUCCESS) {
        std::cerr << op << ": " << rc << '\n';
        std::exit(1);
    }
}

int main(int argc, char** argv) {
    if (argc != 4) return 2;
    const std::string which = argv[1];
    if (which != "11" && which != "13") return 2;
    const bool padded = which == "11";
    const size_t elements = padded ? 273 * 509 : 143 * 536;
    std::vector<float> host(2 * elements);
    const size_t bytes = elements * sizeof(float);
    std::ifstream input(argv[2], std::ios::binary);
    if (!input.read(reinterpret_cast<char*>(host.data()), 2 * bytes) || input.peek() != EOF) return 2;
    check(aclInit(nullptr), "init");
    check(aclrtSetDevice(0), "device");
    aclrtStream stream;
    check(aclrtCreateStream(&stream), "stream");
    void *src, *dst;
    check(aclrtMalloc(&src, 2 * bytes, ACL_MEM_MALLOC_NORMAL_ONLY), "allocate input");
    check(aclrtMalloc(&dst, bytes, ACL_MEM_MALLOC_NORMAL_ONLY), "allocate output");
    check(aclrtMemcpy(src, 2 * bytes, host.data(), 2 * bytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy input");
    auto x = static_cast<float*>(src);
    auto y = static_cast<float*>(dst);
    for (int i = 0; i < 17; ++i) {
        if (padded) {
            short_rows<273,509,8><<<35,256,0,stream>>>(x, y);
        } else {
            short_rows<143,536,4><<<36,256,0,stream>>>(x, y);
        }
        check(aclrtSynchronizeStream(stream), "synchronize");
    }
    check(aclrtMemcpy(host.data(), bytes, dst, bytes, ACL_MEMCPY_DEVICE_TO_HOST), "copy output");
    std::ofstream output(argv[3], std::ios::binary);
    if (!output.write(reinterpret_cast<char*>(host.data()), bytes).flush()) return 1;
    check(aclrtFree(dst), "free output");
    check(aclrtFree(src), "free input");
    check(aclrtDestroyStream(stream), "destroy stream");
    check(aclrtResetDevice(0), "reset device");
    check(aclFinalize(), "finalize");
}
