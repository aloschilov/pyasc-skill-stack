+def swiglu_direct_slab(x: asctile.GlobalAddress, y: asctile.GlobalAddress, i0: asctile.GlobalAddress, i1: asctile.GlobalAddress, R: asctile.ConstExpr[int], H: asctile.ConstExpr[int], TR: asctile.ConstExpr[int], U: asctile.ConstExpr[int]):
